-- Cleanup: tracks running jobs, handles eject/purge/respawn.
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local Cleanup = {}
Cleanup.Jobs = {}
Cleanup.Globals = {}
_G.MatrixHubGlobalCleanups = Cleanup.Globals

local function kill(job)
    if not job or not job.Alive then return end
    job.Alive = false
    if job.Thread then
        pcall(task.cancel, job.Thread)
        job.Thread = nil
    end
    for _, c in ipairs(job.Conns) do
        pcall(function() c:Disconnect() end)
    end
    job.Conns = {}
    for _, fn in ipairs(job.Cleanups) do
        pcall(fn)
    end
    job.Cleanups = {}
    for i, j in ipairs(Cleanup.Jobs) do
        if j == job then table.remove(Cleanup.Jobs, i) break end
    end
end

function Cleanup.NewJob()
    local job = { Alive = true, Conns = {}, Cleanups = {}, Thread = nil }
    job.Kill = function() kill(job) end
    job.Track = function(conn)
        if conn then table.insert(job.Conns, conn) end
        return conn
    end
    job.OnKill = function(fn)
        if type(fn) == "function" then
            table.insert(job.Cleanups, fn)
            table.insert(Cleanup.Globals, fn)
        end
    end
    table.insert(Cleanup.Jobs, job)
    return job
end

function Cleanup.PurgeAll()
    local snap = {}
    for i, j in ipairs(Cleanup.Jobs) do snap[i] = j end
    for _, j in ipairs(snap) do pcall(j.Kill) end
    Cleanup.Jobs = {}
    for _, fn in ipairs(Cleanup.Globals) do pcall(fn) end
    Cleanup.Globals = {}
    _G.MatrixHubGlobalCleanups = Cleanup.Globals
end

LocalPlayer.CharacterAdded:Connect(function() Cleanup.PurgeAll() end)
task.spawn(function()
    local char = LocalPlayer.Character
    if char then
        local h = char:FindFirstChildOfClass("Humanoid")
        if h then h.Died:Connect(function() Cleanup.PurgeAll() end) end
        char.ChildAdded:Connect(function(c)
            if c:IsA("Humanoid") then
                c.Died:Connect(function() Cleanup.PurgeAll() end)
            end
        end)
    end
end)

return Cleanup
