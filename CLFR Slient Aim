--// =====================================================================
--// Silent Aim v6 — Osiris Collective & Research Subject Friendly Check
--// =====================================================================

print("[SilentAim] LOADED v6")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local CONFIG = CONFIG or {
    ["Silent Aim Enabled"] = true,
    ["Aimbot Key"] = "Always", 
    ["FOV"] = 150, 
}

local lmbHeld = false
local rmbHeld = false
local hooksInstalled = false

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then lmbHeld = true end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then rmbHeld = true end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then lmbHeld = false end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then rmbHeld = false end
end)

local function isAimbotActive()
    if not CONFIG["Silent Aim Enabled"] then return false end
    local key = CONFIG["Aimbot Key"]
    if key == "Always" then return true end
    if key == "LeftClick" then return lmbHeld end
    if key == "RightClick" then return rmbHeld end
    local keyCode = Enum.KeyCode[key]
    return keyCode and UserInputService:IsKeyDown(keyCode) or false
end

-- =====================================================================
-- SMART TEAM CHECK (Osiris & Research are friendly unless infected)
-- =====================================================================
local function canTarget(player)
    local myTeam = LocalPlayer.Team
    local theirTeam = player.Team
    if not myTeam or not theirTeam then return false end

    local myTeamName = myTeam.Name
    local theirTeamName = theirTeam.Name

    -- 1. Exclude Choosing entirely
    if theirTeamName == "Choosing" then return false end

    -- 2. Global Infected Check (If they are infected, you can always target them)
    if player:GetAttribute("IsInfected") then
        return true
    end

    -- 3. Osiris Collective Logic
    if myTeamName == "Osiris Collective" then
        -- Friendly with other Osiris
        if theirTeamName == "Osiris Collective" then return false end
        -- Friendly with Research Subject (unless they are infected, which was checked above)
        if theirTeamName == "Research Subject" then return false end
        -- Hostile to Facility teams
        return true
    end

    -- 4. Research Subject Logic
    if myTeamName == "Research Subject" then
        -- Friendly with other Research Subjects
        if theirTeamName == "Research Subject" then return false end
        -- Friendly with Osiris Collective (unless they are infected, checked above)
        if theirTeamName == "Osiris Collective" then return false end
        -- Hostile to Facility teams
        return true
    end

    -- 5. Facility Teams Logic
    local isFacility = (myTeamName == "Facility Response Unit" or myTeamName == "Biohazard Containment Unit" or myTeamName == "Centum Security" or myTeamName == "Domestic Security Agency" or myTeamName == "Facility Oversight" or myTeamName == "Health & Research" or myTeamName == "Administrative Committee")
    
    if isFacility then
        local theirIsFacility = (theirTeamName == "Facility Response Unit" or theirTeamName == "Biohazard Containment Unit" or theirTeamName == "Centum Security" or theirTeamName == "Domestic Security Agency" or theirTeamName == "Facility Oversight" or theirTeamName == "Health & Research" or theirTeamName == "Administrative Committee")
        
        -- Friendly with other Facility teams
        if theirIsFacility then return false end

        -- Hostile to Research Subjects ONLY if they are marked KOS
        if theirTeamName == "Research Subject" then
            local char = player.Character
            if char then
                local head = char:FindFirstChild("Head")
                if head then
                    local nameTag = head:FindFirstChild("NameTag")
                    if nameTag then
                        local kos = nameTag:FindFirstChild("KOS")
                        if kos and kos.Visible then return true end
                    end
                end
            end
            return false
        end
    end

    return false
end

-- =====================================================================
-- TARGETING
-- =====================================================================
local function getTargetHead()
    local closest = nil
    local shortestDist = CONFIG["FOV"]
    local center = Camera.ViewportSize / 2

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if canTarget(player) then
                local head = player.Character:FindFirstChild("Head")
                if head then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if distToCenter < shortestDist then
                            shortestDist = distToCenter
                            closest = head
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function findController(name)
    if shared and shared.Knit and shared.Knit.GetController then
        local ok, c = pcall(shared.Knit.GetController, name)
        if ok and type(c) == "table" then return c end
    end
    if getgc then
        for _, obj in ipairs(getgc(true)) do
            if type(obj) == "table" and rawget(obj, "Name") == name then
                return obj
            end
        end
    end
    return nil
end

local function installHooks()
    if hooksInstalled then return end
    local fc = findController("FirearmController")
    if not fc or type(fc.Fire) ~= "function" then return end
    
    local origFire = fc.Fire
    fc.Fire = function(self, bulletIndex, traceData)
        if isAimbotActive() then
            local targetHead = getTargetHead()
            if targetHead and self.CameraController then
                local origCFrame = self.CameraController.CCF
                local newCFrame = CFrame.lookAt(origCFrame.Position, targetHead.Position)
                self.CameraController.CCF = newCFrame
                
                local ok, result = pcall(origFire, self, bulletIndex, traceData)
                self.CameraController.CCF = origCFrame
                
                if ok then return result end
            end
        end
        return origFire(self, bulletIndex, traceData)
    end
    
    hooksInstalled = true
    print("[SilentAim] Hooks Installed ✔")
end

RunService.Heartbeat:Connect(installHooks)
