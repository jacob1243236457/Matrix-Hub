--// =====================================================================
--// Gun Mods v22 — Auto-Fire + Multi-Bullet
--// =====================================================================

print("[GunMod] LOADED v22")

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local CONFIG = CONFIG or {
    ["Inf Ammo"]          = true,
    ["Recoil"]            = "false",
    ["Spread"]            = false,
    ["Blockage Bypass"]   = true,
    ["Infinite Mag"]      = true,
    ["Bullets Per Shot"]  = 3, 
}

local hooksInstalled = false
local zeroVector = Vector3.new(0, 0, 0)

local function readRecoilOff()
    local v = CONFIG["Recoil"]
    if v == false or v == nil then return true end
    if type(v) == "string" then return v:lower() == "false" end
    return false
end

local function installHooks(fc)
    if hooksInstalled or type(fc.Fire) ~= "function" then return end

    local origFire = fc.Fire
    fc.Fire = function(self, bulletIndex, traceData)
        local bulletCount = tonumber(CONFIG["Bullets Per Shot"])
        
        -- If we want multi-bullets and the gun is NOT already doing it
        if bulletCount and bulletCount > 1 and self.FireModes and self.Stats and self.Stats.Bullet then
            local originalMode = self.FireMode
            local originalCount = self.Stats.Bullet.BulletFireCount
            
            -- Temporarily force Buckshot and change the bullet count
            self.FireMode = self.FireModes.Buckshot
            self.Stats.Bullet.BulletFireCount = bulletCount

            -- Let the original Fire function run
            local ok, result = pcall(origFire, self, bulletIndex, traceData)

            -- Restore immediately so Auto-fire loop continues
            self.FireMode = originalMode
            self.Stats.Bullet.BulletFireCount = originalCount
            
            return result
        end

        return origFire(self, bulletIndex, traceData)
    end

    -- Hook FireRequest just for the Blockage, Recoil, Spread, etc.
    if type(fc.FireRequest) == "function" then
        local origFireRequest = fc.FireRequest
        fc.FireRequest = function(self, ...)
            local origIsBlocked = self.IsFirearmBlocked
            if CONFIG["Blockage Bypass"] then
                self.IsFirearmBlocked = function() return false end
                self.LastBlockUpdateResult = false
            end

            local origBuckSpread
            if not CONFIG["Spread"] and self.Stats and self.Stats.Bullet then
                origBuckSpread = self.Stats.Bullet.BuckshotSpread
                self.Stats.Bullet.BuckshotSpread = 0
            end

            local res = origFireRequest(self, ...)

            if CONFIG["Blockage Bypass"] then self.IsFirearmBlocked = origIsBlocked end
            if origBuckSpread then self.Stats.Bullet.BuckshotSpread = origBuckSpread end
            return res
        end
    end

    -- Hook Recoil
    if type(fc.GetPatternRecoil) == "function" then
        local origRecoil = fc.GetPatternRecoil
        fc.GetPatternRecoil = function(self, index, stats)
            if readRecoilOff() then return zeroVector end
            return origRecoil(self, index, stats)
        end
    end

    hooksInstalled = true
    print("[GunMod] v22 Multi-Bullet Hooks Installed ✔")
end

local function findController()
    if shared and shared.Knit and shared.Knit.GetController then
        local ok, fc = pcall(shared.Knit.GetController, "FirearmController")
        if ok and type(fc) == "table" then return fc end
    end
    if getgc then
        for _, obj in ipairs(getgc(true)) do
            if type(obj) == "table" and rawget(obj, "Name") == "FirearmController" then
                return obj 
            end
        end
    end
    return nil
end

RunService.Heartbeat:Connect(function()
    if not hooksInstalled then
        local fc = findController()
        if fc then installHooks(fc) end
    end
end)

-- Infinite Ammo
local INF_AMMO_VALUE = 50000000
RunService.Heartbeat:Connect(function()
    if not CONFIG["Inf Ammo"] then return end
    local function process(t)
        if t:IsA("Tool") and t:GetAttribute("AmmoLeft") then
            t:SetAttribute("AmmoLeft", INF_AMMO_VALUE)
        end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then for _, t in ipairs(bp:GetChildren()) do process(t) end end
    if LocalPlayer.Character then for _, t in ipairs(LocalPlayer.Character:GetChildren()) do process(t) end end
end)
