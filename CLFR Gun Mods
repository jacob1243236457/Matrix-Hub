--// =====================================================================
--// Gun Mods v25 — Auto Shotgun Loop (Buckshot + Auto)
--// =====================================================================

print("[GunMod] LOADED v25")

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS        = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local CONFIG = CONFIG or {
    ["Inf Ammo"]          = true,
    ["Recoil"]            = "false",
    ["Spread"]            = false,
    ["Blockage Bypass"]   = true,
    ["Infinite Mag"]      = true,
    ["Bullets Per Shot"]  = 3, 
}

local hooksInstalled = false
local zeroVector = Vector3.new(0, 0, 0)
local mouseHeld = false

-- Track if the player is holding the trigger
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then mouseHeld = true end
end)
UIS.InputEnded:Connect(function(input, gameProcessed)
    if not gameProcessed and input.UserInputType == Enum.UserInputType.MouseButton1 then mouseHeld = false end
end)

local function readRecoilOff()
    local v = CONFIG["Recoil"]
    if v == false or v == nil then return true end
    if type(v) == "string" then return v:lower() == "false" end
    return false
end

local function installHooks(fc)
    if hooksInstalled or type(fc.FireRequest) ~= "function" then return end

    local origFireRequest = fc.FireRequest
    fc.FireRequest = function(self, ...)
        local bulletCount = tonumber(CONFIG["Bullets Per Shot"]) or 1

        -- If we want multi-bullets
        if bulletCount > 1 and self.FireModes and self.Stats and self.Stats.Bullet then
            if self._multiBulletActive then return end
            self._multiBulletActive = true

            -- 1. Inject Buckshot into allowed FireModes if it isn't there
            local originalModes = self.FireModes
            local hasBuckshot = false
            for _, mode in pairs(originalModes) do
                if mode == "Buckshot" then hasBuckshot = true break end
            end
            if not hasBuckshot then
                local newModes = {}
                for _, mode in pairs(originalModes) do table.insert(newModes, mode) end
                table.insert(newModes, "Buckshot")
                self.FireModes = newModes
            end

            -- 2. Swap to Buckshot and fire
            local originalMode = self.FireMode
            local originalCount = self.Stats.Bullet.BulletFireCount
            
            self.FireMode = self.FireModes.Buckshot
            self.Stats.Bullet.BulletFireCount = bulletCount

            -- This fires the whole burst
            pcall(origFireRequest, self, ...)

            -- 3. Restore immediately
            self.FireMode = originalMode
            self.Stats.Bullet.BulletFireCount = originalCount
            if not hasBuckshot then self.FireModes = originalModes end

            -- 4. If the mouse is still held down, loop the shot
            if mouseHeld and self.Stats.Bullet and self.Stats.Bullet.RPM then
                local rpm = self.Stats.Bullet.RPM
                task.spawn(function()
                    task.wait(60 / rpm)
                    self._multiBulletActive = false
                    if mouseHeld then
                        self:FireRequest()
                    end
                end)
            else
                self._multiBulletActive = false
            end
            return
        end

        return origFireRequest(self, ...)
    end

    -- Hook Fire for Recoil, Blockage, etc.
    local origFire = fc.Fire
    fc.Fire = function(self, bulletIndex, traceData)
        local origIsBlocked = self.IsFirearmBlocked
        if CONFIG["Blockage Bypass"] then
            self.IsFirearmBlocked = function() return false end
            self.LastBlockUpdateResult = false
        end

        local origAmmoLeft
        if CONFIG["Infinite Mag"] and self.Firearm then
            origAmmoLeft = self.Firearm:GetAttribute("AmmoLeft")
        end

        local origBuckSpread
        if not CONFIG["Spread"] and self.Stats and self.Stats.Bullet then
            origBuckSpread = self.Stats.Bullet.BuckshotSpread
            self.Stats.Bullet.BuckshotSpread = 0
        end

        local ok, result = pcall(origFire, self, bulletIndex, traceData)

        if CONFIG["Blockage Bypass"] then self.IsFirearmBlocked = origIsBlocked end
        if origAmmoLeft ~= nil and self.Firearm and not CONFIG["Inf Ammo"] then
            self.Firearm:SetAttribute("AmmoLeft", math.max(0, origAmmoLeft - 1))
        end
        if origBuckSpread then self.Stats.Bullet.BuckshotSpread = origBuckSpread end
        return result
    end

    -- Hook Recoil
    if type(fc.GetPatternRecoil) == "function" then
        local origRecoil = fc.GetPatternRecoil
        fc.GetPatternRecoil = function(self, index, stats)
            if readRecoilOff() then return zeroVector end
            return origRecoil(self, index, stats)
        end
    end

    hooksInstalled = true
    print("[GunMod] v25 Auto Shotgun Hooks Installed ✔")
end

local function findController()
    if shared and shared.Knit and shared.Knit.GetController then
        local ok, fc = pcall(shared.Knit.GetController, "FirearmController")
        if ok and type(fc) == "table" then return fc end
    end
    if getgc then
        for _, obj in ipairs(getgc(true)) do
            if type(obj) == "table" and rawget(obj, "Name") == "FirearmController" then
                return obj 
            end
        end
    end
    return nil
end

RunService.Heartbeat:Connect(function()
    if not hooksInstalled then
        local fc = findController()
        if fc then installHooks(fc) end
    end
end)

-- Infinite Ammo
local INF_AMMO_VALUE = 50000000
RunService.Heartbeat:Connect(function()
    if not CONFIG["Inf Ammo"] then return end
    local function process(t)
        if t:IsA("Tool") and t:GetAttribute("AmmoLeft") then
            t:SetAttribute("AmmoLeft", INF_AMMO_VALUE)
        end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then for _, t in ipairs(bp:GetChildren()) do process(t) end end
    if LocalPlayer.Character then for _, t in ipairs(LocalPlayer.Character:GetChildren()) do process(t) end end
end)
