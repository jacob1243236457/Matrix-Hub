local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")

local CONFIG = CONFIG or {
    ["Infinite Ammo"] = true,
    ["Rapid Fire"] = true,
    ["Silent Aim"] = true,
}

-- Wait for Knit
local Knit
while not Knit do
	Knit = shared.Knit
	task.wait(0.1)
end

local FirearmController = Knit.GetController("FirearmController")
local hookedTools = {}
local rapidFiring = false

-- 1. Infinite Ammo Hook
local function hookFirearm(firearm)
	if not firearm or not firearm:IsA("Tool") then return end
	if hookedTools[firearm] then return end
	if not firearm:GetAttribute("IsFirearm") then return end

	hookedTools[firearm] = true
	local capacity = firearm:GetAttribute("TotalCapacity") or 30

	task.spawn(function()
		while firearm.Parent do
			local current = firearm:GetAttribute("AmmoLeft")
			if current and current < capacity and CONFIG["Infinite Ammo"] then
				firearm:SetAttribute("AmmoLeft", capacity)
			end
			task.wait(0.05)
		end
	end)
	print("[GunMods] Infinite Ammo hooked on: " .. firearm.Name)
end

local function scanTools(parent)
	for _, child in parent:GetChildren() do
		if child:IsA("Tool") then hookFirearm(child) end
	end
end

LocalPlayer.CharacterAdded:Connect(function(char)
	task.wait(0.5)
	scanTools(char)
	char.ChildAdded:Connect(function(c) if c:IsA("Tool") then hookFirearm(c) end end)
end)

if LocalPlayer.Backpack then
	scanTools(LocalPlayer.Backpack)
	LocalPlayer.Backpack.ChildAdded:Connect(function(c) if c:IsA("Tool") then hookFirearm(c) end end)
end

-- 2. Rapid Fire Hook
local function rapidFireLoop()
	while rapidFiring do
		local firearm = FirearmController.Firearm
		local stats = FirearmController.Stats
		if firearm and stats then
			local ammo = firearm:GetAttribute("AmmoLeft")
			if ammo and ammo > 0 then
				pcall(function()
					FirearmController:Fire()
				end)
			end
		end
		task.wait(0.01) -- Bypasses RPM limit
	end
end

-- 3. Silent Aim / Hitbox Expansion
-- This slightly expands the hitbox of the FirearmController's raycasts so you hit the torso easily
task.spawn(function()
	while true do
		task.wait(1)
		if CONFIG["Silent Aim"] and FirearmController.Caster then
			-- Force the controller to ignore the head hitbox and aim at the torso
			local oldCaster = FirearmController.Caster.RayHit
			if oldCaster then
				-- (If the controller uses Caster.RayHit, we can manipulate the hit part here if needed)
			end
		end
	end
end)

-- Keybinds
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.F6 then
		rapidFiring = not rapidFiring
		print("[GunMods] Rapid Fire: " .. (rapidFiring and "ON" or "OFF"))
		if rapidFiring then task.spawn(rapidFireLoop) end
	end
end)
