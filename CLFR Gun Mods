--// =====================================================================
--// Ultimate Gun Mods (Spread, Recoil, Rapid Fire, Full Auto, etc.)
--// =====================================================================

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local CONFIG = CONFIG or {
    ["Infinite Ammo"] = true,
    ["Rapid Fire"] = true,
    ["Full Auto"] = true,
    ["No Spread"] = true,
    ["No Recoil"] = true,
    ["Bullets Per Shot"] = 3,
    ["Instant Reload"] = true,
    ["HitScan Bullets"] = true,
    ["One Shot Kill"] = true,
    ["Damage Through Walls"] = true
}

-- Wait for Knit
local Knit
while not Knit do
	Knit = shared.Knit
	task.wait(0.1)
end

local FirearmController = Knit.GetController("FirearmController")
local AbilityController = Knit.GetController("AbilityController")
local hookedTools = {}

local function applyWeaponStats()
    local stats = FirearmController.Stats
    if not stats then return end

    if CONFIG["No Spread"] then
        if stats.Spread then stats.Spread.Min = 0; stats.Spread.Max = 0 end
        if stats.Bullet then stats.Bullet.Spread = 0; stats.Bullet.BuckshotSpread = 0 end
    end

    if CONFIG["No Recoil"] then
        if stats.Recoil then stats.Recoil.Max = Vector3.new(0, 0, 0) end
        if stats.Shake then stats.Shake.Magnitude = 0; stats.Shake.Roughness = 0 end
    end

    if CONFIG["Bullets Per Shot"] and CONFIG["Bullets Per Shot"] > 1 then
        if stats.Bullet then
            stats.Bullet.BulletFireCount = CONFIG["Bullets Per Shot"]
            if FirearmController.FireModes and FirearmController.FireModes.Buckshot then
                FirearmController.FireMode = FirearmController.FireModes.Buckshot
            end
        end
    end

    if CONFIG["HitScan Bullets"] and stats.Bullet then
        stats.Bullet.Gravity = Vector3.new(0, 0, 0)
        FirearmController.RangeHardLimit = 99999
        if FirearmController.BulletType then
            FirearmController.BulletType.Velocity = 100000
        end
    end

    if CONFIG["One Shot Kill"] and stats.Damages then
        for key, value in pairs(stats.Damages) do
            if value > 0 then stats.Damages[key] = 100 end
        end
    end
    
    -- Full Auto Bypass
    if CONFIG["Full Auto"] and FirearmController.FireModes then
        FirearmController.FireMode = FirearmController.FireModes.Auto
    end
end

local function hookFirearm(firearm)
	if not firearm or not firearm:IsA("Tool") then return end
	if hookedTools[firearm] then return end
	if not firearm:GetAttribute("IsFirearm") then return end

	hookedTools[firearm] = true
	local capacity = firearm:GetAttribute("TotalCapacity") or 30

	task.spawn(function()
		while firearm.Parent do
			local current = firearm:GetAttribute("AmmoLeft")
			if current and current < capacity and CONFIG["Infinite Ammo"] then
				firearm:SetAttribute("AmmoLeft", capacity)
			end
			task.wait(0.05)
		end
	end)
end

task.spawn(function()
    while true do
        task.wait(0.5)
        if FirearmController.Firearm then applyWeaponStats() end
    end
end)

if CONFIG["Damage Through Walls"] then
    FirearmController.CanDamage = function() return true end
    FirearmController.CanDamageCached = function() return true end
end

local originalReload = FirearmController.Reload
FirearmController.Reload = function(self)
	if not CONFIG["Instant Reload"] then return originalReload(self) end
	if not self.Firearm or not self.Stats or not self.Stats.Bullet then return end
	self.Reloading = true
	task.spawn(function() self.Service:ReloadStart() end)
	self.Firearm:SetAttribute("AmmoLeft", self.Stats.Bullet.Capacity)
	task.spawn(function() self.Service:ReloadEnd() end)
	if self.MainUIController then self.MainUIController:UpdateArmament() end
	self.Reloading = false
	self.IsFiring = false
end

task.spawn(function()
	while true do
		if CONFIG["Rapid Fire"] and FirearmController.Firearm and FirearmController.Stats then
			local ammo = FirearmController.Firearm:GetAttribute("AmmoLeft")
			if ammo and ammo > 0 then pcall(function() FirearmController:Fire() end) end
			task.wait(0.01)
		else
			task.wait(0.1)
		end
	end
end)

local function scanTools(parent)
	for _, child in parent:GetChildren() do
		if child:IsA("Tool") then hookFirearm(child) end
	end
end

LocalPlayer.CharacterAdded:Connect(function(char)
	task.wait(0.5)
	scanTools(char)
	char.ChildAdded:Connect(function(c) if c:IsA("Tool") then hookFirearm(c) end end)
end)

if LocalPlayer.Backpack then
	scanTools(LocalPlayer.Backpack)
	LocalPlayer.Backpack.ChildAdded:Connect(function(c) if c:IsA("Tool") then hookFirearm(c) end end)
end

print("[GunMods] Fully Loaded (Full Auto Included)")
