--// =====================================================================
--// Gun Mods v21 — Fixed Multi-Bullet + Full Cleanup
--// =====================================================================

print("[GunMod] LOADED v21")

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local CONFIG = CONFIG or {
    ["Inf Ammo"]          = true,
    ["Recoil"]            = "false",
    ["Spread"]            = false,
    ["Blockage Bypass"]   = true,
    ["Infinite Mag"]      = true,
    ["Bullets Per Shot"]  = 3, 
}

local hooksInstalled = false
local zeroVector = Vector3.new(0, 0, 0)
local connections = {}
local hookedFire = nil
local hookedFireRequest = nil
local hookedRecoil = nil

local function track(c) table.insert(connections, c); return c end

local function readRecoilOff()
    local v = CONFIG["Recoil"]
    if v == false or v == nil then return true end
    if type(v) == "string" then return v:lower() == "false" end
    return false
end

local function installHooks(fc)
    if hooksInstalled or type(fc.Fire) ~= "function" then return end

    -- 1. Hook Fire
    hookedFire = fc.Fire
    fc.Fire = function(self, bulletIndex, traceData)
        local bulletCount = tonumber(CONFIG["Bullets Per Shot"])
        local origCount
        if bulletCount and bulletCount > 1 and self.Stats and self.Stats.Bullet then
            origCount = self.Stats.Bullet.BulletFireCount
            self.Stats.Bullet.BulletFireCount = bulletCount
        end

        local origIsBlocked = self.IsFirearmBlocked
        if CONFIG["Blockage Bypass"] then
            self.IsFirearmBlocked = function() return false end
            self.LastBlockUpdateResult = false
        end

        local origAmmoLeft
        if CONFIG["Infinite Mag"] and self.Firearm then
            origAmmoLeft = self.Firearm:GetAttribute("AmmoLeft")
        end

        local origBuckSpread
        if not CONFIG["Spread"] and self.Stats and self.Stats.Bullet then
            origBuckSpread = self.Stats.Bullet.BuckshotSpread
            self.Stats.Bullet.BuckshotSpread = 0
        end

        local ok, result = pcall(hookedFire, self, bulletIndex, traceData)

        if origCount ~= nil then self.Stats.Bullet.BulletFireCount = origCount end
        if CONFIG["Blockage Bypass"] then self.IsFirearmBlocked = origIsBlocked end
        if origAmmoLeft ~= nil and self.Firearm and not CONFIG["Inf Ammo"] then
            self.Firearm:SetAttribute("AmmoLeft", math.max(0, origAmmoLeft - 1))
        end
        if origBuckSpread then self.Stats.Bullet.BuckshotSpread = origBuckSpread end

        return result
    end

    -- 2. Hook FireRequest
    if type(fc.FireRequest) == "function" then
        hookedFireRequest = fc.FireRequest
        fc.FireRequest = function(self, ...)
            local bulletCount = tonumber(CONFIG["Bullets Per Shot"])
            if bulletCount and bulletCount > 1 and self.FireModes then
                local originalMode = self.FireMode
                self.FireMode = self.FireModes.Buckshot
                
                local origCount = self.Stats.Bullet.BulletFireCount
                self.Stats.Bullet.BulletFireCount = bulletCount
                
                local res = hookedFireRequest(self, ...)
                
                self.FireMode = originalMode
                self.Stats.Bullet.BulletFireCount = origCount
                return res
            end
            return hookedFireRequest(self, ...)
        end
    end

    -- 3. Hook Recoil
    if type(fc.GetPatternRecoil) == "function" then
        hookedRecoil = fc.GetPatternRecoil
        fc.GetPatternRecoil = function(self, index, stats)
            if readRecoilOff() then return zeroVector end
            return hookedRecoil(self, index, stats)
        end
    end

    hooksInstalled = true
    print("[GunMod] Multi-Bullet Hooks Installed ✔")
end

local function findController()
    if shared and shared.Knit and shared.Knit.GetController then
        local ok, fc = pcall(shared.Knit.GetController, "FirearmController")
        if ok and type(fc) == "table" then return fc end
    end
    if getgc then
        for _, obj in ipairs(getgc(true)) do
            if type(obj) == "table" and rawget(obj, "Name") == "FirearmController" then
                return obj 
            end
        end
    end
    return nil
end

-- Track heartbeat loops
track(RunService.Heartbeat:Connect(function()
    if not hooksInstalled then
        local fc = findController()
        if fc then installHooks(fc) end
    end
end))

-- Infinite Ammo UI tracking
local INF_AMMO_VALUE = 50000000
track(RunService.Heartbeat:Connect(function()
    if not CONFIG["Inf Ammo"] then return end
    local function process(t)
        if t:IsA("Tool") and t:GetAttribute("AmmoLeft") then
            t:SetAttribute("AmmoLeft", INF_AMMO_VALUE)
        end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then for _, t in ipairs(bp:GetChildren()) do process(t) end end
    if LocalPlayer.Character then for _, t in ipairs(LocalPlayer.Character:GetChildren()) do process(t) end end
end))

--// CLEANUP
if cleanup then
    cleanup(function()
        -- 1. Disconnect all loops
        for _, c in ipairs(connections) do
            if c then pcall(function() c:Disconnect() end) end
        end
        connections = {}

        -- 2. Restore the original functions
        local fc = findController()
        if fc then
            if hookedFire then fc.Fire = hookedFire end
            if hookedFireRequest then fc.FireRequest = hookedFireRequest end
            if hookedRecoil then fc.GetPatternRecoil = hookedRecoil end
        end

        -- 3. Clear the UI text
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        local mainUI = playerGui and playerGui:FindFirstChild("MainUI")
        local weaponMgmt = mainUI and mainUI:FindFirstChild("WeaponManagement")
        if weaponMgmt then
            local primary = weaponMgmt:FindFirstChild("Primary")
            local secondary = weaponMgmt:FindFirstChild("Secondary")
            if primary then
                local lbl = primary:FindFirstChild("CurrentAmmo")
                if lbl then lbl.Text = "--" end
            end
            if secondary then
                local lbl = secondary:FindFirstChild("CurrentAmmo")
                if lbl then lbl.Text = "--" end
            end
        end

        print("[GunMod] Cleaned up safely ✔")
    end)
end
