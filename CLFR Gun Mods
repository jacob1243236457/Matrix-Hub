--// =====================================================================
--// Ultimate Gun Mods (Spread, Recoil, Ammo, Rapid Fire, Multi-Bullet)
--// =====================================================================

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local CONFIG = CONFIG or {
    ["Infinite Ammo"] = true,
    ["Rapid Fire"] = true,
    ["No Spread"] = true,
    ["No Recoil"] = true,
    ["Bullets Per Shot"] = 3,
}

-- Wait for Knit
local Knit
while not Knit do
	Knit = shared.Knit
	task.wait(0.1)
end

local FirearmController = Knit.GetController("FirearmController")
local hookedTools = {}

-- Function to modify the weapon stats when equipped
local function applyWeaponStats()
    local stats = FirearmController.Stats
    if not stats then return end

    -- 1. No Spread
    if CONFIG["No Spread"] then
        if stats.Spread then
            stats.Spread.Min = 0
            stats.Spread.Max = 0
        end
        -- Sometimes spread is stored directly on the bullet data
        if stats.Bullet and stats.Bullet.Spread then
            stats.Bullet.Spread = 0
        end
        if stats.Bullet and stats.Bullet.BuckshotSpread then
            stats.Bullet.BuckshotSpread = 0
        end
    end

    -- 2. No Recoil
    if CONFIG["No Recoil"] then
        if stats.Recoil then
            stats.Recoil.Max = Vector3.new(0, 0, 0)
        end
        if stats.Shake then
            stats.Shake.Magnitude = 0
            stats.Shake.Roughness = 0
        end
    end

    -- 3. Bullets Per Shot (Multi-bullet)
    if CONFIG["Bullets Per Shot"] and CONFIG["Bullets Per Shot"] > 1 then
        if stats.Bullet then
            stats.Bullet.BulletFireCount = CONFIG["Bullets Per Shot"]
            -- Force firemode to Buckshot so it shoots multiple pellets
            if FirearmController.FireModes and FirearmController.FireModes.Buckshot then
                FirearmController.FireMode = FirearmController.FireModes.Buckshot
            end
        end
    end
end

-- 4. Infinite Ammo
local function hookFirearm(firearm)
	if not firearm or not firearm:IsA("Tool") then return end
	if hookedTools[firearm] then return end
	if not firearm:GetAttribute("IsFirearm") then return end

	hookedTools[firearm] = true
	local capacity = firearm:GetAttribute("TotalCapacity") or 30

	task.spawn(function()
		while firearm.Parent do
			local current = firearm:GetAttribute("AmmoLeft")
			if current and current < capacity and CONFIG["Infinite Ammo"] then
				firearm:SetAttribute("AmmoLeft", capacity)
			end
			task.wait(0.05)
		end
	end)
end

-- 5. Apply Stats whenever a new weapon is equipped or stats change
FirearmController.StatsChanged = function(self)
    task.spawn(applyWeaponStats)
end

-- Also loop every second just in case the game resets the stats
task.spawn(function()
    while true do
        task.wait(0.5)
        if FirearmController.Firearm then
            applyWeaponStats()
        end
    end
end)

-- 6. Rapid Fire
task.spawn(function()
	while true do
		if CONFIG["Rapid Fire"] and FirearmController.Firearm and FirearmController.Stats then
			local firearm = FirearmController.Firearm
			local ammo = firearm:GetAttribute("AmmoLeft")
			if ammo and ammo > 0 then
				pcall(function()
					FirearmController:Fire()
				end)
			end
			task.wait(0.01) -- Spam fire
		else
			task.wait(0.1)
		end
	end
end)

-- Scan for tools to apply Infinite Ammo
local function scanTools(parent)
	for _, child in parent:GetChildren() do
		if child:IsA("Tool") then hookFirearm(child) end
	end
end

LocalPlayer.CharacterAdded:Connect(function(char)
	task.wait(0.5)
	scanTools(char)
	char.ChildAdded:Connect(function(c) if c:IsA("Tool") then hookFirearm(c) end end)
end)

if LocalPlayer.Backpack then
	scanTools(LocalPlayer.Backpack)
	LocalPlayer.Backpack.ChildAdded:Connect(function(c) if c:IsA("Tool") then hookFirearm(c) end end)
end

print("[GunMods] Fully Loaded! (Spread, Recoil, Ammo, Rapid Fire, Multi-Bullet)")
