-- IconLoader: dedicated module to resolve and cache game icons reliably.
local HttpService = game:GetService("HttpService")

local IconLoader = {}
local cache = {}

function IconLoader.Get(placeId)
    local numId = tonumber(placeId)
    if not numId then return "rbxassetid://6023426915" end

    if cache[numId] then return cache[numId] end

    -- Try the Roblox API first. It returns a direct PNG link that always loads.
    local ok, url = pcall(function()
        local req = request or http_request or (syn and syn.request) or (http and http.request)
        if req then
            local res = req({
                Url = "https://thumbnails.roblox.com/v1/places/gameicons?placeIds=" .. numId .. "&returnPolicy=PlaceHolder&size=150x150&format=Png&isCircular=false",
                Method = "GET"
            })
            if res and res.Body then
                local data = HttpService:JSONDecode(res.Body)
                if data and data.data and data.data[1] and data.data[1].imageUrl then
                    return data.data[1].imageUrl
                end
            end
        end
        return nil
    end)

    if ok and url then
        cache[numId] = url
        return url
    end

    -- Fallback: rbxthumb (works natively but sometimes fails on specific executors)
    local fallback = "rbxthumb://type=GameIcon&id=" .. tostring(numId) .. "&w=150&h=150"
    cache[numId] = fallback
    return fallback
end

return IconLoader
