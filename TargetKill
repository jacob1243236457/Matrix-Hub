--// =====================================================================
--// Server-Sided Target Remote v2 — Melee Specific
--// =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local CONFIG = CONFIG or {
    ["Target User"] = "",
}

print("[TargetRemote] LOADED. Target:", (CONFIG["Target User"] == "" and "Everyone" or CONFIG["Target User"]))

-- Find the MELEE hit remote specifically
local hitRemote = nil
for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
    if obj:IsA("RemoteEvent") then
        -- Look for Knit MeleeService or standard Hit names
        if string.find(obj:GetFullName(), "MeleeService") and obj.Name == "Hit" then
            hitRemote = obj
            break
        elseif obj.Name == "MeleeHit" or obj.Name == "HitMelee" then
            hitRemote = obj
            break
        end
    end
end

-- Fallback if MeleeService is named differently
if not hitRemote then
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and obj.Name == "Hit" and not string.find(obj:GetFullName(), "Firearm") then
            hitRemote = obj
            break
        end
    end
end

if not hitRemote then
    warn("[TargetRemote] Could not find MELEE hit remote.")
    return
end

print("[TargetRemote] Found Melee Remote:", hitRemote:GetFullName())

local mouseHeld = false

UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        mouseHeld = true
    end
end)

UIS.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        mouseHeld = false
    end
end)

RunService.Heartbeat:Connect(function()
    if mouseHeld then
        local targetName = CONFIG["Target User"]
        
        local function fireAt(targetPlayer)
            if not targetPlayer or not targetPlayer.Character then return end
            task.spawn(function()
                pcall(function()
                    -- Try common Melee arguments
                    hitRemote:FireServer(targetPlayer.Character, "HardHit")
                    hitRemote:FireServer(targetPlayer.Character, "Hit")
                    hitRemote:FireServer(targetPlayer.Character)
                end)
            end)
        end

        if targetName and targetName ~= "" then
            -- Target specific user
            local targetPlayer = Players:FindFirstChild(targetName)
            if targetPlayer then fireAt(targetPlayer) end
        else
            -- Target everyone
            for _, targetPlayer in ipairs(Players:GetPlayers()) do
                if targetPlayer ~= LocalPlayer then
                    fireAt(targetPlayer)
                end
            end
        end
        task.wait(0.05) -- Spam rate
    end
end)
