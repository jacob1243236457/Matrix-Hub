--// DIAGNOSTIC SCRIPT — Melee Remote Test
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

print("=== STARTING MELEE REMOTE DIAGNOSTIC ===")

-- 1. Find the remote
local hitRemote = nil
for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
    if obj:IsA("RemoteEvent") and (obj.Name == "Hit" or obj.Name == "MeleeHit") then
        if not string.find(obj:GetFullName(), "Firearm") then
            hitRemote = obj
            break
        end
    end
end

if not hitRemote then
    warn("❌ DIAGNOSTIC FAILED: Could not find a Melee hit remote.")
    return
else
    print("✅ Found Remote:", hitRemote:GetFullName())
end

-- 2. Hook the remote to see if the server sends a response back
hitRemote.OnClientEvent:Connect(function(...)
    print("📥 SERVER RESPONDED TO REMOTE:", ...)
end)

-- 3. Find a target to test on
local function getClosestTarget()
    local closest = nil
    local minDist = math.huge
    local myPos = LocalPlayer.Character and LocalPlayer.Character.PrimaryPart and LocalPlayer.Character.PrimaryPart.Position
    
    if not myPos then return nil, 0 end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character.PrimaryPart then
            local dist = (p.Character.PrimaryPart.Position - myPos).Magnitude
            if dist < minDist then
                minDist = dist
                closest = p
            end
        end
    end
    return closest, minDist
end

local fired = false
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or fired then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        fired = true
        
        local target, dist = getClosestTarget()
        if not target then
            warn("❌ DIAGNOSTIC FAILED: No target player found.")
            return
        end
        
        print("🎯 Closest Target:", target.Name, "| Distance:", math.floor(dist), "studs")
        
        -- Test 1: Standard Melee Arguments
        print("➡️ Firing Remote: (Character, 'HardHit')")
        hitRemote:FireServer(target.Character, "HardHit")
        task.wait(0.5)
        
        -- Test 2: Just Character
        print("➡️ Firing Remote: (Character)")
        hitRemote:FireServer(target.Character)
        task.wait(0.5)
        
        -- Test 3: Player Object
        print("➡️ Firing Remote: (Player)")
        hitRemote:FireServer(target)
        
        print("=== DIAGNOSTIC COMPLETE. DID THEY DIE? ===")
        fired = false
    end
end)
