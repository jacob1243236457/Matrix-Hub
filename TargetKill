--// =====================================================================
--// Server-Sided Target Remote — Spams One or Everyone
--// =====================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local CONFIG = CONFIG or {
    ["Target User"] = "",
}

print("[TargetRemote] LOADED. Target:", (CONFIG["Target User"] == "" and "Everyone" or CONFIG["Target User"]))

-- Find the hit remote
local hitRemote = nil
for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
    if obj:IsA("RemoteEvent") and (obj.Name == "Hit" or obj.Name == "ReplicateHit" or obj.Name == "MeleeHit") then
        hitRemote = obj
        print("[TargetRemote] Found Hit Remote:", hitRemote:GetFullName())
        break
    end
end

if not hitRemote then
    warn("[TargetRemote] Could not find melee hit remote.")
    return
end

local mouseHeld = false

UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        mouseHeld = true
    end
end)

UIS.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        mouseHeld = false
    end
end)

RunService.Heartbeat:Connect(function()
    if mouseHeld then
        local targetName = CONFIG["Target User"]
        
        -- If a target name is set, ONLY hit them
        if targetName and targetName ~= "" then
            local targetPlayer = Players:FindFirstChild(targetName)
            if targetPlayer and targetPlayer.Character then
                task.spawn(function()
                    pcall(function()
                        hitRemote:FireServer(targetPlayer.Character, "HardHit")
                        hitRemote:FireServer(targetPlayer.Character, "Hit")
                        hitRemote:FireServer(targetPlayer.Character)
                        hitRemote:FireServer(targetPlayer)
                    end)
                end)
            end
        else
            -- If blank, hit EVERYONE
            for _, targetPlayer in ipairs(Players:GetPlayers()) do
                if targetPlayer ~= LocalPlayer and targetPlayer.Character then
                    task.spawn(function()
                        pcall(function()
                            hitRemote:FireServer(targetPlayer.Character, "HardHit")
                            hitRemote:FireServer(targetPlayer.Character, "Hit")
                            hitRemote:FireServer(targetPlayer.Character)
                            hitRemote:FireServer(targetPlayer)
                        end)
                    end)
                end
            end
        end
        task.wait(0.05) -- Spam rate
    end
end)
