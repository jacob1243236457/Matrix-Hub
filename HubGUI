local function CreateGameTab(gameData)
	local isUniversal = false
	if typeof(gameData.GameId) == "string" then
		isUniversal = gameData.GameId:lower() == "universal" or gameData.GameId == "0"
	elseif typeof(gameData.GameId) == "number" then
		isUniversal = gameData.GameId == 0
	end

	local gameNameText = "Loading..."
	local gameIconImage = "rbxassetid://6023426915"

	if not isUniversal and tonumber(gameData.GameId) then
		local placeId = tonumber(gameData.GameId)
		gameIconImage = "rbxthumb://type=GameIcon&id=" .. tostring(placeId) .. "&w=150&h=150"
		pcall(function()
			local info = MarketplaceService:GetProductInfo(placeId, Enum.InfoType.Game)
			if info and info.Name then gameNameText = info.Name end
		end)
	else
		gameNameText = "Universal Scripts"
	end

	local GameBtn = make("TextButton", "Game_" .. tostring(gameData.GameId), GamesHolder, {
		Size = UDim2.new(0, 160, 0, 50),
		BackgroundColor3 = Color3.fromRGB(45, 45, 45),
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = true,
		LayoutOrder = #GamesHolder:GetChildren(),
	})
	make("UICorner", "GameCorner", GameBtn, { CornerRadius = UDim.new(0, 5) })

	make("ImageLabel", "GameIcon", GameBtn, {
		Size = UDim2.new(0, 40, 0, 40),
		Position = UDim2.new(0, 5, 0.5, -20),
		Image = gameIconImage,
		BackgroundTransparency = 1,
	})

	make("TextLabel", "GameName", GameBtn, {
		Size = UDim2.new(0, 110, 1, 0),
		Position = UDim2.new(0, 50, 0, 0),
		Text = gameNameText,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextSize = 13,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local GameScrollingFrame = make("ScrollingFrame", "Tab_" .. tostring(gameData.GameId), ScriptsContainer, {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Color3.fromRGB(100, 100, 100),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
	})
	
	make("UIListLayout", "TabLayout", GameScrollingFrame, { Padding = UDim.new(0, 6) })

	local Section = make("Frame", "Section", GameScrollingFrame, {
		Size = UDim2.new(0, 410, 0, 0),
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	make("UIListLayout", "SectionLayout", Section, { Padding = UDim.new(0, 6) })

	for i, scriptInfo in ipairs(gameData.scripts) do
		local hasOptions = scriptInfo.configValues and next(scriptInfo.configValues) ~= nil
		local itemHeight = hasOptions and 75 or 35
		
		local ScriptHolder = make("Frame", "Script_" .. tostring(i), Section, {
			Size = UDim2.new(0, 410, 0, itemHeight),
			BackgroundColor3 = Color3.fromRGB(30, 30, 30),
			BorderSizePixel = 0,
			LayoutOrder = i,
		})
		make("UICorner", "HolderCorner", ScriptHolder, { CornerRadius = UDim.new(0, 5) })
		make("UIStroke", "HolderStroke", ScriptHolder, { Thickness = 1, Color = Color3.fromRGB(60, 60, 60) })

		make("TextLabel", "ScriptName", ScriptHolder, {
			Size = UDim2.new(1, -90, 0, 30),
			Position = UDim2.new(0, 7, 0, 2),
			Text = scriptInfo.Name or "Unnamed Script",
			TextColor3 = Color3.fromRGB(255, 255, 255),
			TextSize = 15,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
		})

		local ExecBtn = make("TextButton", "ExecBtn", ScriptHolder, {
			Size = UDim2.new(0, 75, 0, 25),
			Position = UDim2.new(1, -80, 0, 5),
			BackgroundColor3 = Color3.fromRGB(50, 50, 50),
			BorderSizePixel = 0,
			Text = "Execute",
			TextColor3 = Color3.fromRGB(135, 135, 135),
			TextSize = 13,
			Font = Enum.Font.Gotham,
			AutoButtonColor = true,
		})
		make("UICorner", "BtnCorner", ExecBtn, { CornerRadius = UDim.new(0, 5) })
		make("UIStroke", "BtnStroke", ExecBtn, { Thickness = 1, Color = Color3.fromRGB(60, 60, 60) })

		if hasOptions then
			local OptionsFrame = make("Frame", "Options", ScriptHolder, {
				Size = UDim2.new(0, 410, 0, 36),
				Position = UDim2.new(0, 0, 0, 34),
				BackgroundTransparency = 1,
			})
			
			local optIndex = 1
			for key, val in pairs(scriptInfo.configValues) do
				local OptHolder = make("Frame", "Opt_" .. tostring(optIndex), OptionsFrame, {
					Size = UDim2.new(0, 410, 0, 30),
					Position = UDim2.new(0, 0, 0, (optIndex - 1) * 34),
					BackgroundColor3 = Color3.fromRGB(35, 35, 35),
					BorderSizePixel = 0,
				})
				make("UICorner", "OptCorner", OptHolder, { CornerRadius = UDim.new(0, 5) })
				make("UIStroke", "OptStroke", OptHolder, { Thickness = 1, Color = Color3.fromRGB(60, 60, 60) })

				make("TextLabel", "OptName", OptHolder, {
					Size = UDim2.new(0, 290, 1, 0),
					Position = UDim2.new(0, 7, 0, 0),
					Text = tostring(key),
					TextColor3 = Color3.fromRGB(200, 200, 200),
					TextSize = 14,
					Font = Enum.Font.Gotham,
					TextXAlignment = Enum.TextXAlignment.Left,
					BackgroundTransparency = 1,
				})

				local Input = make("TextBox", "OptInput", OptHolder, {
					Size = UDim2.new(0, 75, 0, 20),
					Position = UDim2.new(1, -80, 0.5, -10),
					BackgroundColor3 = Color3.fromRGB(50, 50, 50),
					BorderSizePixel = 0,
					Text = tostring(val),
					TextColor3 = Color3.fromRGB(135, 135, 135),
					PlaceholderText = tostring(val),
					TextSize = 13,
					Font = Enum.Font.Gotham,
					TextXAlignment = Enum.TextXAlignment.Center,
					ClearTextOnFocus = false,
				})
				make("UICorner", "InputCorner", Input, { CornerRadius = UDim.new(0, 5) })
				make("UIStroke", "InputStroke", Input, { Thickness = 1, Color = Color3.fromRGB(60, 60, 60) })

				Input.FocusLost:Connect(function()
					local text = Input.Text
					if tonumber(text) then
						scriptInfo.configValues[key] = tonumber(text)
					elseif text == "true" or text == "false" then
						scriptInfo.configValues[key] = (text == "true")
					else
						scriptInfo.configValues[key] = text
					end
				end)
				optIndex += 1
			end
		end

		ExecBtn.MouseButton1Click:Connect(function()
			-- Cleanup old scripts before executing
			KillAllScripts()

			local code = scriptInfo.Source
			if scriptInfo.Url then
				local bust = ("%d_%d_%d"):format(os.time(), math.floor(os.clock() * 1e6), math.random(1, 1e9))
				local ok, res = pcall(game.HttpGet, game, scriptInfo.Url .. "?t=" .. bust)
				if ok and type(res) == "string" and #res > 10 and res:sub(1, 1) ~= "<" then
					code = res
				end
			end

			if code then
				local fn, err = loadstring(code, scriptInfo.Name or "script")
				if fn then
					local env = getfenv(fn)
					env.CONFIG = scriptInfo.configValues or {}
					
					local thread = task.spawn(function()
					    local success, execErr = pcall(fn)
					    if not success then
						    warn("[ProHub] Error running " .. scriptInfo.Name .. ": " .. tostring(execErr))
					    end
					end)
					table.insert(RunningScripts, thread)
				else
					warn("[ProHub] Loadstring error for " .. scriptInfo.Name .. ": " .. tostring(err))
				end
			else
				warn("[ProHub] Failed to get source for " .. scriptInfo.Name)
			end
		end)
	end

	GameBtn.MouseButton1Click:Connect(function()
		for _, child in pairs(ScriptsContainer:GetChildren()) do
			if child:IsA("ScrollingFrame") then child.Visible = false end
		end
		GameScrollingFrame.Visible = true
	end)

	return GameScrollingFrame
end

-- Build tabs from config
if configData and type(configData) == "table" then
	local firstTab
	for _, gameData in ipairs(configData) do
		local tab = CreateGameTab(gameData)
		if not firstTab then firstTab = tab end
	end
	if firstTab then firstTab.Visible = true end
else
	make("TextLabel", "Error", ScriptsContainer, {
		Size = UDim2.new(1, 0, 1, 0),
		Text = "Config data missing.",
		TextColor3 = Color3.fromRGB(255, 100, 100),
		TextSize = 16,
		Font = Enum.Font.GothamBold,
		BackgroundTransparency = 1,
	})
end
