local function make(className, name, parent, props)
	local inst = Instance.new(className)
	inst.Name = name
	if props then
		for k, v in pairs(props) do
			inst[k] = v
		end
	end
	inst.Parent = parent
	return inst
end

-- ===================== Cleanup Logic =====================
local RunningScripts = {}
local function KillAllScripts()
    for _, thread in ipairs(RunningScripts) do
        pcall(function() task.cancel(thread) end)
    end
    RunningScripts = {}
end
_G.ProHubCleanup = KillAllScripts

