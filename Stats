local function formatRegionCode(rawRegion)
    if not rawRegion then return "N/A" end
    local cleanString = string.upper(string.gsub(tostring(rawRegion), "^%s*(.-)%s*$", "%1"))
    if shortToFullCountries[cleanString] then
        return shortToFullCountries[cleanString]
    end
    return tostring(rawRegion)
end

