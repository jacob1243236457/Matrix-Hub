    table.insert(renderedNodes, nodeContainer)
    return nodeDot
end

local function drawConnectingLine(nA, nB)
    if not nA or not nB then return end
    
    local line = Instance.new("Frame")
    line.BackgroundColor3 = Color3.fromRGB(70, 130, 200)
    line.BorderSizePixel = 0
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.Parent = graphPanel
    
    local function updateLine()
        local pA = nA.AbsolutePosition + (nA.AbsoluteSize / 2) - graphPanel.AbsolutePosition
        local pB = nB.AbsolutePosition + (nB.AbsoluteSize / 2) - graphPanel.AbsolutePosition
        local distance = (pA - pB).Magnitude
        line.Size = UDim2.new(0, distance, 0, 2)
        line.Position = UDim2.new(0, (pA.X + pB.X) / 2, 0, (pA.Y + pB.Y) / 2)
        line.Rotation = math.deg(math.atan2(pB.Y - pA.Y, pB.X - pA.X))
    end
    
    updateLine()
    table.insert(renderedLines, line)
end

local function getWorkspaceOrPlayerAttribute(targetPlayer, attributeName)
    if not targetPlayer then return nil end
    
    local characterModel = Workspace:FindFirstChild(targetPlayer.Name)
    if characterModel then
        local characterVal = characterModel:GetAttribute(attributeName)
        if characterVal ~= nil then return characterVal end
    end
    
    local playerVal = targetPlayer:GetAttribute(attributeName)
    if playerVal ~= nil then return playerVal end
    
    return nil
end

-- Refresh UI values on updating attributes
local function refreshDiagnosticDisplay()
    if not activeTargetPlayer then return end
    
    local paidAccessAttr = getWorkspaceOrPlayerAttribute(activeTargetPlayer, "HasBeenAwardedPaidAccessReward")
    local halfsiteAttr = getWorkspaceOrPlayerAttribute(activeTargetPlayer, "HasBeenAwardedHalfsiteReward")
    local isEliteAttr = getWorkspaceOrPlayerAttribute(activeTargetPlayer, "IsElite")
    
    local rawRegionCode = getWorkspaceOrPlayerAttribute(activeTargetPlayer, "RegionCode")
    local regionCode = formatRegionCode(rawRegionCode)
    
    local currentSector = getWorkspaceOrPlayerAttribute(activeTargetPlayer, "CurrentSector") or "N/A"
    local preciseSector = getWorkspaceOrPlayerAttribute(activeTargetPlayer, "CurrentSectorPrecise") or "N/A"
    
    rawWeightValue = tonumber(getWorkspaceOrPlayerAttribute(activeTargetPlayer, "Weight")) or 0
    
    local veteranStatus = (paidAccessAttr == nil) and "N/A" or ((paidAccessAttr == true) and "True" or "False")
    local halfsiteStatus = (halfsiteAttr == nil) and "N/A" or ((halfsiteAttr == true) and "True" or "False")
    local eliteStatus = (isEliteAttr == nil) and "N/A" or ((isEliteAttr == true) and "True" or "False")
    
    local healthDisplay = "N/A"
    local characterModel = Workspace:FindFirstChild(activeTargetPlayer.Name)
    if characterModel then
        local humanoid = characterModel:FindFirstChildOfClass("Humanoid")
        if humanoid then
            healthDisplay = string.format("%.0f/%.0f", humanoid.Health, humanoid.MaxHealth)
        end
    end
    
    local isMutantAttr = getWorkspaceOrPlayerAttribute(activeTargetPlayer, "IsMutant")
    local mutantStatus = "No"
    if isMutantAttr == true then mutantStatus = "Yes" elseif isMutantAttr == nil then mutantStatus = "N/A" end
    
    local exposureVal = getWorkspaceOrPlayerAttribute(activeTargetPlayer, "Exposure") or "N/A"
    local evolutionVal = getWorkspaceOrPlayerAttribute(activeTargetPlayer, "PotentialEvolution") or "N/A"
    
    local displayString = string.format(
        "Veteran: %s\nHalsite: %s\nElite: %s\nRegion: %s\nSector: %s\nPreciseSector: %s\nHealth: %s\nExposure: %s\nMutated: %s\nEvolution: %s",
        veteranStatus, halfsiteStatus, eliteStatus, tostring(regionCode), tostring(currentSector), tostring(preciseSector),
        healthDisplay, tostring(exposureVal), mutantStatus, tostring(evolutionVal)
    )
    
    handleLabel.Text = "@" .. activeTargetPlayer.Name
    detailsLabel.Text = displayString
    
    updateWeightDisplay()
    clearGraph()
    
    local agilityVal = tonumber(getWorkspaceOrPlayerAttribute(activeTargetPlayer, "AgilityAttribute")) or 0
    local strengthVal = tonumber(getWorkspaceOrPlayerAttribute(activeTargetPlayer, "StrengthAttribute")) or 0
    local intelligenceVal = tonumber(getWorkspaceOrPlayerAttribute(activeTargetPlayer, "IntelligenceAttribute")) or 0
    
    local dotA = createNode(0.25, agilityVal)
    local dotB = createNode(0.50, strengthVal)
    local dotC = createNode(0.75, intelligenceVal)
    
    drawConnectingLine(dotA, dotB)
    drawConnectingLine(dotB, dotC)
end

-- Hooks real-time updating triggers instantly
local function hookRealtimeListeners(targetPlayer)
    disconnectActiveListeners()
    activeTargetPlayer = targetPlayer
    
    if not targetPlayer then return end
    
    table.insert(activeConnections, targetPlayer.AttributeChanged:Connect(refreshDiagnosticDisplay))
    
    local function setupCharacterHook(charModel)
        if not charModel or charModel.Name ~= targetPlayer.Name then return end
        
        table.insert(activeConnections, charModel.AttributeChanged:Connect(refreshDiagnosticDisplay))
        
        local humanoid = charModel:FindFirstChildOfClass("Humanoid")
        if humanoid then
            table.insert(activeConnections, humanoid.HealthChanged:Connect(refreshDiagnosticDisplay))
            table.insert(activeConnections, humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(refreshDiagnosticDisplay))
        end
        refreshDiagnosticDisplay()
    end
    
    local initialChar = Workspace:FindFirstChild(targetPlayer.Name)
    if initialChar then setupCharacterHook(initialChar) end
    
    table.insert(activeConnections, Workspace.ChildAdded:Connect(setupCharacterHook))
    table.insert(activeConnections, Workspace.ChildRemoved:Connect(function(child)
        if child.Name == targetPlayer.Name then
            task.defer(refreshDiagnosticDisplay)
        end
    end))
    
    refreshDiagnosticDisplay()
end

local function runSearch()
    local input = searchBar.Text
    if input == "" then return end
    
    local foundPlayer = nil
    local lowerInput = string.lower(input)
    
    for _, p in pairs(Players:GetPlayers()) do
        if string.lower(p.Name):sub(1, #input) == lowerInput or string.lower(p.DisplayName):sub(1, #input) == lowerInput then
            foundPlayer = p
            break
        end
    end
    
    if not foundPlayer then
        disconnectActiveListeners()
        activeTargetPlayer = nil
        handleLabel.Text = "@UserNotFound"
        detailsLabel.Text = "User is not in this server."
        clearGraph()
        return
    end
    
    hookRealtimeListeners(foundPlayer)
end

searchBar.FocusLost:Connect(function(enterPressed)
    if enterPressed then runSearch() end
end)

