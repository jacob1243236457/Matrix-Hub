--// =====================================================================
--// Melee & Punch Mods v27 — Clean (Spam + No Stamina)
--// =====================================================================

print("[MeleeMod] LOADED v27")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local CONFIG = CONFIG or {
    ["Spam Swing"] = true,
    ["No Stamina"] = true,
    ["Spam Punch"] = true,
}

local hooksInstalled = false
local mouseHeld = false
local connections = {}
local hookedSwing = nil
local hookedPunch = nil

local function track(c) table.insert(connections, c); return c end

local function findTable(name, requiredFuncs)
    if getgc then
        for _, obj in ipairs(getgc(true)) do
            if type(obj) == "table" then
                local match = true
                if name and rawget(obj, "Name") ~= name then match = false end
                if match and requiredFuncs then
                    for _, func in ipairs(requiredFuncs) do
                        if type(rawget(obj, func)) ~= "function" then match = false; break end
                    end
                end
                if match then return obj end
            end
        end
    end
    return nil
end

local function installMods()
    if hooksInstalled then return end

    -- Melee Controller
    local mc = findTable("MeleeController", {"_swing"})
    if mc then
        hookedSwing = mc._swing
        mc._swing = function(self, isCharged)
            local state = self._state
            if not state then return hookedSwing(self, isCharged) end

            local origHas, origSpend
            if CONFIG["No Stamina"] then
                origHas = self.StaminaController.HasStamina
                origSpend = self.StaminaController.Spend
                self.StaminaController.HasStamina = function() return true end
                self.StaminaController.Spend = function() end
            end

            local res = hookedSwing(self, isCharged)

            if CONFIG["Spam Swing"] and self._state then
                self._state.BusyUntil = 0
                self._state.PendingPress = nil
                self._state.Lockout = false
            end

            if CONFIG["No Stamina"] then
                self.StaminaController.HasStamina = origHas
                self.StaminaController.Spend = origSpend
            end
            return res
        end
    end

    -- Punch Controller
    local pc = findTable("PunchController", {"Punch"})
    if pc then
        hookedPunch = pc.Punch
        pc.Punch = function(self, ...)
            local origSpend
            if CONFIG["No Stamina"] and self.StaminaController then
                origSpend = self.StaminaController.Spend
                self.StaminaController.Spend = function() end
            end

            local res = hookedPunch(self, ...)

            if CONFIG["Spam Punch"] then
                self.LastPunchAt = 0
            end

            if CONFIG["No Stamina"] and origSpend then
                self.StaminaController.Spend = origSpend
            end
            return res
        end
    end

    if hookedSwing or hookedPunch then
        hooksInstalled = true
        print("[MeleeMod] Hooks Installed ✔")
    end
end

track(UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then mouseHeld = true end
end))

track(UIS.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then mouseHeld = false end
end))

track(RunService.Heartbeat:Connect(function()
    installMods()
    if mouseHeld then
        if CONFIG["Spam Swing"] then
            local mc = findTable("MeleeController", {"_swing"})
            if mc and mc._state then mc._state.BusyUntil = 0; mc._state.Lockout = false end
        end
        if CONFIG["Spam Punch"] then
            local pc = findTable("PunchController", {"Punch"})
            if pc then pc.LastPunchAt = 0 end
        end
    end
end))

local function cleanupMods()
    for _, c in ipairs(connections) do if c then pcall(function() c:Disconnect() end) end end
    connections = {}
    mouseHeld = false

    local mc = findTable("MeleeController", {"_swing"})
    if mc and hookedSwing then mc._swing = hookedSwing; hookedSwing = nil end

    local pc = findTable("PunchController", {"Punch"})
    if pc and hookedPunch then pc.Punch = hookedPunch; hookedPunch = nil end

    if mc and mc.StaminaController then
        pcall(function()
            if type(mc.StaminaController.SetStamina) == "function" then mc.StaminaController:SetStamina(100) end
        end)
    end
    if mc and mc._state then mc._state.BusyUntil = 0 end
    if pc then pc.LastPunchAt = 0 end
    print("[MeleeMod] Cleaned up safely ✔")
end

if cleanup then cleanup(cleanupMods) end
eject = cleanupMods
