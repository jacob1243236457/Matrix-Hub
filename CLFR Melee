local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local CONFIG = CONFIG or {
    ["Spam Punch"] = true,
    ["Spam Swing"] = true,
    ["No Stamina"] = true,
    ["Melee Reach"] = 50,
    ["Aura Punch"] = false
}

-- Wait for Knit
local Knit
while not Knit do
	Knit = shared.Knit
	task.wait(0.1)
end

local PunchController = Knit.GetController("PunchController")
local MeleeController = Knit.GetController("MeleeController")
local PunchService = Knit.GetService("PunchService")
local StaminaController = Knit.GetController("StaminaController")

-- 1. Bypass Stamina
if CONFIG["No Stamina"] and StaminaController then
    local originalSpend = StaminaController.Spend
    StaminaController.Spend = function(self, amount)
        return true -- Do nothing, never drain stamina
    end
    
    local originalHas = StaminaController.HasStamina
    if originalHas then
        StaminaController.HasStamina = function(self) return true end
    end
    print("[MeleeMod] Infinite Stamina Active ✔")
end

-- 2. Melee Reach & Bypass CanHit
if CONFIG["Melee Reach"] and CONFIG["Melee Reach"] > 10 then
    local success, MeleeHitDetection = pcall(require, game:GetService("ReplicatedStorage").Shared.SharedModules.MeleeHitDetection)
    if success and MeleeHitDetection then
        local originalCheck = MeleeHitDetection.check
        MeleeHitDetection.check = function(character, params)
            params.reach = CONFIG["Melee Reach"]
            params.maxTargets = 999 -- Hit everyone in range
            params.canHit = function(target) return true end -- Hit through walls
            return originalCheck(character, params)
        end
        print("[MeleeMod] Melee Reach set to " .. CONFIG["Melee Reach"] .. " studs ✔")
    end
end

-- 3. Spam Punch (Cooldown Bypass)
local originalPunch = PunchController.Punch
PunchController.Punch = function(self, ...)
    if CONFIG["Spam Punch"] then
        self.LastPunchAt = 0
        if self.Character and self.Character:GetAttribute("PunchDisabled") then
            self.Character:SetAttribute("PunchDisabled", false)
        end
    end
    return originalPunch(self, ...)
end
print("[MeleeMod] Rapid Punch Active ✔")

-- 4. Spam Swing (Cooldown Bypass)
local originalSwing = MeleeController.Swing
if originalSwing then
    MeleeController.Swing = function(self, ...)
        if CONFIG["Spam Swing"] then
            if self.LastSwingAt then self.LastSwingAt = 0 end
            if self._state then 
                self._state.BusyUntil = 0 
                self._state.Lockout = false
            end
        end
        return originalSwing(self, ...)
    end
end
print("[MeleeMod] Rapid Swing Active ✔")

-- 5. Auto Punch Aura (If enabled)
task.spawn(function()
    while true do
        task.wait(0.5)
        if CONFIG["Aura Punch"] and LocalPlayer.Character and LocalPlayer.Character.PrimaryPart then
            local myPos = LocalPlayer.Character.PrimaryPart.Position
            
            -- Find players to punch
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character.PrimaryPart then
                    local dist = (player.Character.PrimaryPart.Position - myPos).Magnitude
                    if dist < 100 then
                        -- Punch them directly through the server
                        pcall(function()
                            PunchService:Punch(player)
                        end)
                    end
                end
            end
        end
    end
end)
