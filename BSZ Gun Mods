--[[
    Blacksite Zeta — Gun Modifications (Hub Integrated)
    Fixed: CONFIG priority, NumberBullets placement, safety checks
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local function getCombat()
    local ps = Players.LocalPlayer:FindFirstChildOfClass("PlayerScripts")
    local mod = ps and ps:FindFirstChild("ClientCombatController")
    mod = mod and mod:FindFirstChild("Modules")
    mod = mod and mod:FindFirstChild("Weapons")
    mod = mod and mod:FindFirstChild("Combat")
    if not mod then return nil end
    local ok, Combat = pcall(require, mod)
    if ok and Combat and Combat.CurrentWeapons then
        return Combat
    end
    return nil
end

local function applyMods(weapon, activeConfig)
    if not weapon or type(weapon) ~= "table" then return end

    -- Fire delay
    if activeConfig.FireDelaySeconds ~= nil then
        weapon.FireDelaySeconds = activeConfig.FireDelaySeconds
    end

    -- Data-based mods (spread / recoil)
    if weapon.Data and type(weapon.Data) == "table" then
        if activeConfig.SpreadRadius ~= nil then
            weapon.Data.SpreadRadius = activeConfig.SpreadRadius
        end
        if activeConfig.CamRecoilMin ~= nil then
            weapon.Data.CamRecoilMin = activeConfig.CamRecoilMin
        end
        if activeConfig.CamRecoilMax ~= nil then
            weapon.Data.CamRecoilMax = activeConfig.CamRecoilMax
        end
        -- NumberBullets may live in Data on some weapons
        if activeConfig.NumberBullets ~= nil then
            weapon.Data.NumberBullets = activeConfig.NumberBullets
        end
    end

    -- Infinite ammo
    if activeConfig.InfiniteAmmo then
        if weapon.ClipSize and weapon.ClipSize > 0 then
            if weapon.Ammo < weapon.ClipSize then
                weapon.Ammo = weapon.ClipSize
            end
        else
            weapon.ClipSize = 999
            weapon.Ammo = 999
        end
    end

    -- NumberBullets (top-level, if the weapon uses it there)
    if activeConfig.NumberBullets ~= nil then
        weapon.NumberBullets = activeConfig.NumberBullets
    end
end

if shared.BZ_GunMods_Connection then
    shared.BZ_GunMods_Connection:Disconnect()
    shared.BZ_GunMods_Connection = nil
end

local connection = RunService.Heartbeat:Connect(function()
    -- Resolve config each tick: prefer hub-injected CONFIG (env), then _G.CONFIG, then defaults
    local activeConfig = CONFIG or rawget(_G, "CONFIG") or {
        FireDelaySeconds = 0.01,
        SpreadRadius = 0,
        CamRecoilMin = Vector3.new(0, 0, 0),
        CamRecoilMax = Vector3.new(0, 0, 0),
        InfiniteAmmo = true,
        NumberBullets = 3,
    }

    local Combat = getCombat()
    if not Combat then return end
    for _, weapon in pairs(Combat.CurrentWeapons) do
        applyMods(weapon, activeConfig)
    end
end)

shared.BZ_GunMods_Connection = connection

if type(cleanup) == "function" then
    cleanup(function()
        if shared.BZ_GunMods_Connection then
            shared.BZ_GunMods_Connection:Disconnect()
            shared.BZ_GunMods_Connection = nil
        end
    end)
end
