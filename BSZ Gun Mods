print("[BZ GunMods] VERSION 3 — no-pairs-on-instances")

--[[
    Blacksite Zeta — Gun Modifications (v3)
    Works without weapon equipped. Applies to all weapons found.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- ════════════════════════════════════════════════════════════════
-- CONFIG
-- ════════════════════════════════════════════════════════════════

local DEFAULT_CONFIG = {
    FireDelaySeconds = 0.01,
    SpreadRadius = 0,
    CamRecoilMin = Vector3.new(0, 0, 0),
    CamRecoilMax = Vector3.new(0, 0, 0),
    InfiniteAmmo = true,
    NumberBullets = 3,
}

local function resolveConfig()
    local cfg = CONFIG
    if type(cfg) ~= "table" then cfg = DEFAULT_CONFIG end
    for k, v in pairs(DEFAULT_CONFIG) do
        if cfg[k] == nil then cfg[k] = v end
    end
    return cfg
end

-- ════════════════════════════════════════════════════════════════
-- COMBAT MODULE
-- ════════════════════════════════════════════════════════════════

local function getCombat()
    local ps = LocalPlayer:FindFirstChildOfClass("PlayerScripts")
    local mod = ps and ps:FindFirstChild("ClientCombatController")
    mod = mod and mod:FindFirstChild("Modules")
    mod = mod and mod:FindFirstChild("Weapons")
    mod = mod and mod:FindFirstChild("Combat")
    if not mod then return nil end
    local ok, Combat = pcall(require, mod)
    if ok and Combat and Combat.CurrentWeapons then return Combat end
    return nil
end

-- ════════════════════════════════════════════════════════════════
-- WEAPON DETECTION / APPLICATION
-- ════════════════════════════════════════════════════════════════

local function looksLikeWeapon(t)
    if type(t) ~= "table" then return false end
    if t.FireDelaySeconds ~= nil then return true end
    if t.NumberBullets ~= nil then return true end
    if t.Ammo ~= nil and t.ClipSize ~= nil then return true end
    if type(t.Data) == "table" then
        local d = t.Data
        if d.SpreadRadius ~= nil or d.CamRecoilMin ~= nil or d.CamRecoilMax ~= nil then
            return true
        end
    end
    return false
end

local function applyMods(weapon, cfg)
    if type(weapon) ~= "table" then return end
    weapon.FireDelaySeconds = cfg.FireDelaySeconds
    if type(weapon.Data) == "table" then
        weapon.Data.SpreadRadius = cfg.SpreadRadius
        weapon.Data.CamRecoilMin = cfg.CamRecoilMin
        weapon.Data.CamRecoilMax = cfg.CamRecoilMax
        weapon.Data.NumberBullets = cfg.NumberBullets
    end
    if cfg.InfiniteAmmo then
        if weapon.ClipSize and weapon.ClipSize > 0 then
            if weapon.Ammo < weapon.ClipSize then weapon.Ammo = weapon.ClipSize end
        else
            weapon.ClipSize = 999
            weapon.Ammo = 999
        end
    end
    weapon.NumberBullets = cfg.NumberBullets
end

-- ════════════════════════════════════════════════════════════════
-- DISCOVERY — every loop uses ipairs/GetChildren, never pairs on Instance
-- ════════════════════════════════════════════════════════════════

local weaponCache = setmetatable({}, { __mode = "k" })
local cacheOrder = {}

local function remember(weapon)
    if type(weapon) ~= "table" then return end
    if weaponCache[weapon] then return end
    weaponCache[weapon] = true
    table.insert(cacheOrder, weapon)
    if #cacheOrder > 256 then
        local drop = table.remove(cacheOrder, 1)
        weaponCache[drop] = nil
    end
end

-- Accept only a table. Never pairs() an Instance.
local function harvestFromValue(t, out)
    if type(t) ~= "table" then return end
    if looksLikeWeapon(t) then
        table.insert(out, t)
        return
    end
    -- only recurse through table-typed values
    for _, v in pairs(t) do
        if type(v) == "table" and looksLikeWeapon(v) then
            table.insert(out, v)
        end
    end
end

-- Scan a Tool Instance via GetChildren() only.
local function harvestFromTool(tool, out)
    if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then return end

    -- 1. Any attribute on the tool that is a table
    local okAttrs, attrs = pcall(function() return tool:GetAttributes() end)
    if okAttrs and type(attrs) == "table" then
        for _, v in pairs(attrs) do
            harvestFromValue(v, out)
        end
    end

    -- 2. GetChildren() — always returns an array table
    local children = tool:GetChildren()  -- safe
    for _, child in ipairs(children) do
        -- ValueBase values could hold a weapon table on some executors
        if typeof(child) == "Instance" and child:IsA("ValueBase") then
            local ok, v = pcall(function() return child.Value end)
            if ok then harvestFromValue(v, out) end
        end
    end
end

local function gatherWeapons(Combat)
    local found = {}

    -- 1. Combat.CurrentWeapons — only iterate if it's genuinely a table
    if Combat and type(Combat.CurrentWeapons) == "table" then
        for _, w in pairs(Combat.CurrentWeapons) do
            harvestFromValue(w, found)
        end
    end

    -- 2. Other Combat sub-tables
    if Combat then
        local names = { "Weapons", "WeaponInstances", "AllWeapons", "WeaponCache" }
        for i = 1, #names do
            local t = Combat[names[i]]
            if type(t) == "table" then
                for _, w in pairs(t) do
                    harvestFromValue(w, found)
                end
            end
        end
    end

    -- 3. Backpack — GetChildren() is safe
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        local kids = backpack:GetChildren()
        for i = 1, #kids do
            local obj = kids[i]
            if typeof(obj) == "Instance" and obj:IsA("Tool") then
                harvestFromTool(obj, found)
            end
        end
    end

    -- 4. Character — GetChildren() is safe
    local char = LocalPlayer.Character
    if char then
        local kids = char:GetChildren()
        for i = 1, #kids do
            local obj = kids[i]
            if typeof(obj) == "Instance" and obj:IsA("Tool") then
                harvestFromTool(obj, found)
            end
        end
    end

    -- 5. Cache
    for i = 1, #cacheOrder do
        local w = cacheOrder[i]
        if weaponCache[w] and type(w) == "table" then
            table.insert(found, w)
        end
    end

    for i = 1, #found do
        remember(found[i])
    end
    return found
end

-- ════════════════════════════════════════════════════════════════
-- HEARTBEAT LOOP
-- ════════════════════════════════════════════════════════════════

if shared.BZ_GunMods_Connection then
    shared.BZ_GunMods_Connection:Disconnect()
    shared.BZ_GunMods_Connection = nil
end

shared.BZ_GunMods_Connection = RunService.Heartbeat:Connect(function()
    local ok, err = pcall(function()
        local cfg = resolveConfig()
        local Combat = getCombat()
        local weapons = gatherWeapons(Combat)
        for i = 1, #weapons do
            applyMods(weapons[i], cfg)
        end
    end)
    if not ok then
        warn("[BZ GunMods] tick error:", err)
    end
end)

-- ════════════════════════════════════════════════════════════════
-- CONTROL FUNCTIONS
-- ════════════════════════════════════════════════════════════════

shared.BZ_GunMods_Stop = function()
    if shared.BZ_GunMods_Connection then
        shared.BZ_GunMods_Connection:Disconnect()
        shared.BZ_GunMods_Connection = nil
    end
end

shared.BZ_GunMods_Status = function()
    local Combat = getCombat()
    local cfg = resolveConfig()
    local weapons = {}
    local seen = {}
    local list = gatherWeapons(Combat)
    for i = 1, #list do
        local w = list[i]
        if not seen[w] then
            seen[w] = true
            table.insert(weapons, {
                fireDelay = w.FireDelaySeconds,
                numBullets = w.NumberBullets,
                ammo = w.Ammo,
                clipSize = w.ClipSize,
                spread = w.Data and w.Data.SpreadRadius or "nil",
                recoilMin = w.Data and tostring(w.Data.CamRecoilMin) or "nil",
            })
        end
    end
    return { active = shared.BZ_GunMods_Connection ~= nil, config = cfg, weapons = weapons }
end

local acActive = shared.BZ_AC_BYPASS ~= nil and type(shared.BZ_AC_Arsenal_Snapshots) == "table"
if not acActive then
    warn("[BZ GunMods] WARNING: AC bypass not active — run bz_ac_bypass.luau first")
end

if type(cleanup) == "function" then
    cleanup(function()
        if shared.BZ_GunMods_Connection then
            shared.BZ_GunMods_Connection:Disconnect()
            shared.BZ_GunMods_Connection = nil
        end
    end)
end
