-- Resolve icon asset id from a place id, cached per place.
local iconCache = {}
local function resolveIconAsset(placeId)
    local numId = tonumber(placeId)
    if not numId then return nil end
    if iconCache[numId] ~= nil then return iconCache[numId] end
    local ok, info = pcall(function()
        return MarketplaceService:GetProductInfo(numId, Enum.InfoType.Asset)
    end)
    local assetId = ok and info and info.IconImageAssetId or nil
    if not assetId or assetId == 0 then
        ok, info = pcall(function()
            return MarketplaceService:GetProductInfo(numId, Enum.InfoType.Game)
        end)
        assetId = ok and info and info.IconImageAssetId or nil
    end
    iconCache[numId] = assetId and assetId ~= 0 and assetId or false
    return iconCache[numId]
end

local function setIcon(icon, placeId)
    local numId = tonumber(placeId)
    if not numId then
        icon.Image = "rbxassetid://6023426915"
        return
    end
    -- Try the asset-id route first (works for every executor).
    local assetId = resolveIconAsset(numId)
    if assetId then
        icon.Image = "rbxthumb://type=Asset&id=" .. tostring(assetId) .. "&w=150&h=150"
        return
    end
    -- Fallback: direct place thumbnail.
    icon.Image = "rbxthumb://type=GameIcon&id=" .. tostring(numId) .. "&w=150&h=150"
end

