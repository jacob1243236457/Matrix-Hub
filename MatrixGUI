-- MatrixGUI: builds the hub panel and returns references.
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or CoreGui

local function build()
    local old
    for _, g in ipairs(PlayerGui:GetChildren()) do
        if g.Name == "MatrixLoadstringHub" and g:IsA("ScreenGui") then old = g break end
    end
    if not old then
        for _, g in ipairs(CoreGui:GetChildren()) do
            if g.Name == "MatrixLoadstringHub" and g:IsA("ScreenGui") then old = g break end
        end
    end
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "MatrixLoadstringHub"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    if syn and syn.protect_gui then syn.protect_gui(gui) gui.Parent = CoreGui
    elseif gethui then gui.Parent = gethui()
    else gui.Parent = PlayerGui end

    local main = Instance.new("Frame")
    main.Size = UDim2.new(0, 620, 0, 420)
    main.Position = UDim2.new(0.5, -310, 0.5, -210)
    main.BackgroundColor3 = Color3.fromRGB(6, 10, 6)
    main.BackgroundTransparency = 0.02
    main.BorderSizePixel = 0
    main.Active = true
    main.Draggable = true
    main.Parent = gui
    Instance.new("UICorner", main).CornerRadius = UDim.new(0, 10)
    local ms = Instance.new("UIStroke", main)
    ms.Color = Color3.fromRGB(0, 255, 65)
    ms.Thickness = 1.5
    ms.Transparency = 0.2

    local canvas = Instance.new("Frame")
    canvas.Size = UDim2.new(1, 0, 1, 0)
    canvas.BackgroundTransparency = 1
    canvas.ClipsDescendants = true
    canvas.ZIndex = 0
    canvas.Parent = main

    task.spawn(function()
        local cols, cw = 45, 620 / 45
        local chars = {"0","1","A","B","C","D","E","F","X","Z","S","T","R","H","I","N"}
        for i = 1, cols do
            task.spawn(function()
                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(0, cw + 4, 1, 260)
                lbl.Position = UDim2.new(0, (i - 1) * cw - 2, 0, -260)
                lbl.BackgroundTransparency = 1
                lbl.TextColor3 = Color3.fromRGB(0, 255, 65)
                lbl.TextTransparency = math.random(25, 60) / 100
                lbl.TextSize = 11
                lbl.Font = Enum.Font.Code
                lbl.TextXAlignment = Enum.TextXAlignment.Center
                lbl.TextYAlignment = Enum.TextYAlignment.Top
                lbl.ZIndex = 0
                lbl.Parent = canvas

                local function fill()
                    local t = ""
                    for _ = 1, 35 do t = t .. chars[math.random(1, #chars)] .. "\n" end
                    return t
                end
                lbl.Text = fill()
                local y = -260
                local spd = math.random(90, 180)
                while gui.Parent and lbl.Parent do
                    y = y + spd * task.wait()
                    if y > 480 then
                        y = -320
                        spd = math.random(90, 180)
                        lbl.Text = fill()
                    end
                    lbl.Position = UDim2.new(0, (i - 1) * cw - 2, 0, y)
                end
            end)
        end
    end)

    local top = Instance.new("Frame")
    top.Size = UDim2.new(1, 0, 0, 36)
    top.BackgroundColor3 = Color3.fromRGB(4, 7, 4)
    top.BackgroundTransparency = 0.1
    top.BorderSizePixel = 0
    top.ZIndex = 2
    top.Parent = main
    Instance.new("UICorner", top).CornerRadius = UDim.new(0, 10)
    local cover = Instance.new("Frame")
    cover.Size = UDim2.new(1, 0, 0, 10)
    cover.Position = UDim2.new(0, 0, 1, -10)
    cover.BackgroundColor3 = Color3.fromRGB(4, 7, 4)
    cover.BorderSizePixel = 0
    cover.ZIndex = 2
    cover.Parent = top

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -50, 1, 0)
    title.Position = UDim2.new(0, 14, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = "MATRIX // LOADSTRING HUB"
    title.TextColor3 = Color3.fromRGB(0, 255, 65)
    title.TextSize = 13
    title.Font = Enum.Font.Code
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.ZIndex = 3
    title.Parent = top

    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 28, 0, 28)
    close.Position = UDim2.new(1, -32, 0, 4)
    close.BackgroundColor3 = Color3.fromRGB(0, 40, 10)
    close.BackgroundTransparency = 0.3
    close.BorderSizePixel = 0
    close.Text = "X"
    close.TextColor3 = Color3.fromRGB(0, 255, 65)
    close.TextSize = 13
    close.Font = Enum.Font.Code
    close.ZIndex = 3
    close.Parent = top
    Instance.new("UICorner", close).CornerRadius = UDim.new(0, 6)
    local cs = Instance.new("UIStroke", close)
    cs.Color = Color3.fromRGB(0, 255, 65)
    cs.Transparency = 0.4

    local content = Instance.new("Frame")
    content.Size = UDim2.new(1, -16, 1, -48)
    content.Position = UDim2.new(0, 8, 0, 40)
    content.BackgroundTransparency = 1
    content.ZIndex = 2
    content.Parent = main

    local sidebar = Instance.new("Frame")
    sidebar.Size = UDim2.new(0, 175, 1, -6)
    sidebar.Position = UDim2.new(0, 0, 0, 3)
    sidebar.BackgroundTransparency = 1
    sidebar.ZIndex = 2
    sidebar.Parent = content

    local profile = Instance.new("Frame")
    profile.Size = UDim2.new(1, 0, 0, 56)
    profile.Position = UDim2.new(0, 0, 1, -56)
    profile.BackgroundColor3 = Color3.fromRGB(8, 15, 8)
    profile.BackgroundTransparency = 0.2
    profile.BorderSizePixel = 0
    profile.ZIndex = 2
    profile.Parent = sidebar
    Instance.new("UICorner", profile).CornerRadius = UDim.new(0, 8)
    local pfs = Instance.new("UIStroke", profile)
    pfs.Color = Color3.fromRGB(0, 255, 65)
    pfs.Transparency = 0.5

    local avatar = Instance.new("ImageLabel")
    avatar.Size = UDim2.new(0, 40, 0, 40)
    avatar.Position = UDim2.new(0, 8, 0.5, -20)
    avatar.BackgroundColor3 = Color3.fromRGB(0, 40, 10)
    avatar.BorderSizePixel = 0
    pcall(function()
        avatar.Image = Players:GetUserThumbnailAsync(
            LocalPlayer.UserId,
            Enum.ThumbnailType.HeadShot,
            Enum.ThumbnailSize.Size150x150
        )
    end)
    avatar.ZIndex = 2
    avatar.Parent = profile
    Instance.new("UICorner", avatar).CornerRadius = UDim.new(1, 0)

    local dName = Instance.new("TextLabel")
    dName.Size = UDim2.new(1, -56, 0, 20)
    dName.Position = UDim2.new(0, 54, 0, 8)
    dName.BackgroundTransparency = 1
    dName.Text = LocalPlayer.DisplayName
    dName.TextColor3 = Color3.fromRGB(255, 255, 255)
    dName.TextSize = 11
    dName.Font = Enum.Font.Code
    dName.TextXAlignment = Enum.TextXAlignment.Left
    dName.TextTruncate = Enum.TextTruncate.AtEnd
    dName.ZIndex = 2
    dName.Parent = profile

    local uName = Instance.new("TextLabel")
    uName.Size = UDim2.new(1, -56, 0, 18)
    uName.Position = UDim2.new(0, 54, 0, 26)
    uName.BackgroundTransparency = 1
    uName.Text = "@" .. LocalPlayer.Name
    uName.TextColor3 = Color3.fromRGB(0, 255, 65)
    uName.TextSize = 10
    uName.Font = Enum.Font.Code
    uName.TextXAlignment = Enum.TextXAlignment.Left
    uName.TextTruncate = Enum.TextTruncate.AtEnd
    uName.ZIndex = 2
    uName.Parent = profile

    local gameList = Instance.new("ScrollingFrame")
    gameList.Size = UDim2.new(1, 0, 1, -62)
    gameList.BackgroundColor3 = Color3.fromRGB(8, 15, 8)
    gameList.BackgroundTransparency = 0.5
    gameList.BorderSizePixel = 0
    gameList.CanvasSize = UDim2.new(0, 0, 0, 0)
    gameList.ScrollBarThickness = 2
    gameList.ScrollBarImageColor3 = Color3.fromRGB(0, 255, 65)
    gameList.ZIndex = 2
    gameList.Parent = sidebar
    local gll = Instance.new("UIListLayout", gameList)
    gll.SortOrder = Enum.SortOrder.LayoutOrder
    gll.Padding = UDim.new(0, 6)
    local glp = Instance.new("UIPadding", gameList)
    glp.PaddingTop = UDim.new(0, 6); glp.PaddingBottom = UDim.new(0, 6)
    glp.PaddingLeft = UDim.new(0, 6); glp.PaddingRight = UDim.new(0, 6)

    local scriptArea = Instance.new("Frame")
    scriptArea.Size = UDim2.new(1, -183, 1, -6)
    scriptArea.Position = UDim2.new(0, 183, 0, 3)
    scriptArea.BackgroundColor3 = Color3.fromRGB(8, 15, 8)
    scriptArea.BackgroundTransparency = 0.5
    scriptArea.BorderSizePixel = 0
    scriptArea.ClipsDescendants = true
    scriptArea.ZIndex = 2
    scriptArea.Parent = content

    local scriptScroll = Instance.new("ScrollingFrame")
    scriptScroll.Size = UDim2.new(1, -8, 1, -8)
    scriptScroll.Position = UDim2.new(0, 4, 0, 4)
    scriptScroll.BackgroundTransparency = 1
    scriptScroll.BorderSizePixel = 0
    scriptScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scriptScroll.ScrollBarThickness = 2
    scriptScroll.ScrollBarImageColor3 = Color3.fromRGB(0, 255, 65)
    scriptScroll.ClipsDescendants = true
    scriptScroll.ZIndex = 2
    scriptScroll.Parent = scriptArea
    local sll = Instance.new("UIListLayout", scriptScroll)
    sll.SortOrder = Enum.SortOrder.LayoutOrder
    sll.Padding = UDim.new(0, 6)
    local slp = Instance.new("UIPadding", scriptScroll)
    slp.PaddingTop = UDim.new(0, 4); slp.PaddingBottom = UDim.new(0, 4)
    slp.PaddingLeft = UDim.new(0, 4); slp.PaddingRight = UDim.new(0, 4)

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, 0, 1, 0)
    status.BackgroundTransparency = 1
    status.Text = "INITIALIZING CORE..."
    status.TextColor3 = Color3.fromRGB(0, 255, 65)
    status.TextSize = 12
    status.Font = Enum.Font.Code
    status.ZIndex = 2
    status.Parent = scriptScroll

    local function clearArea()
        for _, c in ipairs(scriptScroll:GetChildren()) do
            if c ~= sll and c ~= slp then c:Destroy() end
        end
    end

    return {
        ScreenGui = gui,
        MainFrame = main,
        CloseButton = close,
        GameListScroll = gameList,
        GameListLayout = gll,
        GameListPadding = glp,
        ScriptScroll = scriptScroll,
        ScriptLayout = sll,
        ScriptPadding = slp,
        StatusLabel = status,
        ClearScriptArea = clearArea,
    }
end

return build()
