-- Card with background prefetch so EXECUTE is instant.
local function buildCard(scriptInfo, parent, Cleanup, onExecute)
    local mode = (scriptInfo.Mode or "toggle"):lower()
    local cfgCount = 0
    if type(scriptInfo.configValues) == "table" then
        for _ in pairs(scriptInfo.configValues) do cfgCount += 1 end
    end
    local h = 44 + (cfgCount > 0 and (cfgCount * 28 + 12) or 0)

    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, h)
    card.BackgroundColor3 = Color3.fromRGB(8, 15, 8)
    card.BackgroundTransparency = 0.2
    card.BorderSizePixel = 0
    card.ClipsDescendants = true
    card.ZIndex = 2
    card.Parent = parent
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)
    local st = Instance.new("UIStroke", card)
    st.Color = Color3.fromRGB(0, 255, 65); st.Transparency = 0.5

    local nameL = Instance.new("TextLabel")
    nameL.Size = UDim2.new(1, -95, 0, 44)
    nameL.Position = UDim2.new(0, 12, 0, 0)
    nameL.BackgroundTransparency = 1
    nameL.Text = scriptInfo.Name or "Unnamed"
    nameL.TextColor3 = Color3.fromRGB(220, 255, 230)
    nameL.TextSize = 12
    nameL.Font = Enum.Font.Code
    nameL.TextXAlignment = Enum.TextXAlignment.Left
    nameL.TextTruncate = Enum.TextTruncate.AtEnd
    nameL.ZIndex = 2
    nameL.Parent = card

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 80, 0, 28)
    btn.Position = UDim2.new(1, -86, 0, 8)
    btn.BackgroundColor3 = Color3.fromRGB(0, 45, 12)
    btn.BackgroundTransparency = 0.2
    btn.BorderSizePixel = 0
    btn.Text = "EXECUTE"
    btn.TextColor3 = Color3.fromRGB(0, 255, 65)
    btn.TextSize = 11
    btn.Font = Enum.Font.Code
    btn.ZIndex = 3
    btn.Parent = card
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local bst = Instance.new("UIStroke", btn)
    bst.Color = Color3.fromRGB(0, 255, 65); bst.Transparency = 0.3

    -- Prefetch source in the background the moment the card exists.
    local prefetched, prefetching = nil, false
    local function prefetch()
        if prefetched or prefetching then return end
        prefetching = true
        if not scriptInfo.Url then
            prefetched = scriptInfo.Source
            prefetching = false
            return
        end
        task.spawn(function()
            local bust = ("%d_%d_%d"):format(os.time(), math.floor(os.clock() * 1e6), math.random(1, 1e9))
            local ok, res = pcall(game.HttpGet, game, scriptInfo.Url .. "?t=" .. bust)
            if ok and type(res) == "string" and #res > 10 and res:sub(1, 1) ~= "<" then
                prefetched = res
            end
            prefetching = false
        end)
    end
    task.spawn(prefetch)

    if type(scriptInfo.configValues) == "table" and cfgCount > 0 then
        local cont = Instance.new("Frame")
        cont.Size = UDim2.new(1, -16, 0, h - 52)
        cont.Position = UDim2.new(0, 8, 0, 44)
        cont.BackgroundTransparency = 1
        cont.ZIndex = 2
        cont.Parent = card
        local ll = Instance.new("UIListLayout", cont)
        ll.SortOrder = Enum.SortOrder.LayoutOrder; ll.Padding = UDim.new(0, 4)

        for key, val in pairs(scriptInfo.configValues) do
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 24)
            row.BackgroundTransparency = 1
            row.ZIndex = 2
            row.Parent = cont

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(0.5, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = tostring(key) .. ":"
            lbl.TextColor3 = Color3.fromRGB(0, 200, 50)
            lbl.TextSize = 10
            lbl.Font = Enum.Font.Code
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.ZIndex = 2
            lbl.Parent = row

            local box = Instance.new("TextBox")
            box.Size = UDim2.new(0.5, 0, 1, 0)
            box.Position = UDim2.new(0.5, 0, 0, 0)
            box.BackgroundColor3 = Color3.fromRGB(10, 20, 10)
            box.BorderSizePixel = 0
            box.Text = tostring(val)
            box.TextColor3 = Color3.fromRGB(255, 255, 255)
            box.TextSize = 10
            box.Font = Enum.Font.Code
            box.ZIndex = 3
            box.Parent = row
            Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

            local last = val
            box:GetPropertyChangedSignal("Text"):Connect(function()
                local t = box.Text
                if t ~= "" then
                    if tonumber(t) then last = tonumber(t)
                    elseif t == "true" or t == "false" then last = (t == "true")
                    else last = t end
                    scriptInfo.configValues[key] = last
                end
            end)
            box.FocusLost:Connect(function()
                if box.Text == "" then box.Text = tostring(last) end
                scriptInfo.configValues[key] = last
            end)
        end
    end

    local state = { Active = nil, IsRunning = false }

    local function setExec()
        btn.Text = "EXECUTE"
        btn.TextColor3 = Color3.fromRGB(0, 255, 65)
        bst.Color = Color3.fromRGB(0, 255, 65)
        btn.BackgroundColor3 = Color3.fromRGB(0, 45, 12)
        state.IsRunning = false
    end
    local function setEject()
        btn.Text = "EJECT"
        btn.TextColor3 = Color3.fromRGB(255, 60, 60)
        bst.Color = Color3.fromRGB(255, 60, 60)
        btn.BackgroundColor3 = Color3.fromRGB(45, 10, 10)
        state.IsRunning = true
    end

    local function run()
        -- Use prefetched source; fetch only if prefetch failed or not done yet.
        local code = prefetched or scriptInfo.Source
        if not code then
            if scriptInfo.Url then
                local bust = ("%d_%d_%d"):format(os.time(), math.floor(os.clock() * 1e6), math.random(1, 1e9))
                local ok, res = pcall(game.HttpGet, game, scriptInfo.Url .. "?t=" .. bust)
                if ok and type(res) == "string" and #res > 10 and res:sub(1, 1) ~= "<" then
                    code = res
                    prefetched = res
                end
            end
        end
        if not code then
            warn("[Hub] no source for " .. tostring(scriptInfo.Name))
            return false
        end
        local fn, err = loadstring(code, scriptInfo.Name or "script")
        if not fn then
            warn("[Hub] loadstring failed: " .. tostring(err))
            return false
        end

        local job = Cleanup.NewJob()
        state.Active = job
        local ctask = setmetatable({}, { __index = task })
        ctask.wait = function(...)
            if not job.Alive then error("Process Ejected", 0) end
            return task.wait(...)
        end

        local env = {
            script = card,
            CONFIG = scriptInfo.configValues or {},
            cleanup = function(f) job.OnKill(f) end,
            eject = function() job.Kill() setExec() end,
            task = ctask,
        }
        setfenv(fn, setmetatable(env, { __index = getfenv() }))

        job.Thread = task.spawn(function()
            local ok, runErr = pcall(fn)
            if not ok and runErr ~= "Process Ejected" then
                warn("[Hub] " .. tostring(scriptInfo.Name) .. ": " .. tostring(runErr))
            end
            if job.Alive and mode == "toggle" then
                setExec(); state.Active = nil
            end
        end)
        return true
    end

    btn.MouseButton1Click:Connect(function()
        if mode == "once" or mode == "fire" then
            if onExecute then onExecute() end
            run()
            btn.Text = "RAN"
            task.delay(1, function() if btn.Parent then setExec() end end)
            return
        end
        if state.Active and state.Active.Alive then
            state.Active.Kill(); state.Active = nil; setExec()
        else
            if onExecute then onExecute() end
            if run() then setEject() end
        end
    end)

    task.spawn(function()
        while card.Parent do
            if state.Active and not state.Active.Alive then
                state.Active = nil; setExec()
            end
            task.wait(0.5)
        end
    end)

    return { Frame = card, State = state, Run = run, SetExec = setExec, SetEject = setEject }
end

local function buildGameButton(gameData, parent, onClick)
    local isUniversal = false
    if typeof(gameData.GameId) == "string" then
        isUniversal = gameData.GameId:lower() == "universal" or gameData.GameId == "0"
    elseif typeof(gameData.GameId) == "number" then
        isUniversal = gameData.GameId == 0
    end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 50)
    btn.BackgroundColor3 = Color3.fromRGB(8, 15, 8)
    btn.BackgroundTransparency = 0.3
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Text = ""
    btn.ZIndex = 2
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local bst = Instance.new("UIStroke", btn)
    bst.Color = Color3.fromRGB(0, 255, 65); bst.Transparency = 0.7

    local icon = Instance.new("ImageLabel")
    icon.Size = UDim2.new(0, 36, 0, 36)
    icon.Position = UDim2.new(0, 7, 0.5, -18)
    icon.BackgroundColor3 = Color3.fromRGB(0, 40, 10)
    icon.BorderSizePixel = 0
    icon.ZIndex = 2
    icon.Parent = btn
    Instance.new("UICorner", icon).CornerRadius = UDim.new(0, 4)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -52, 1, 0)
    lbl.Position = UDim2.new(0, 48, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = "Place " .. tostring(gameData.GameId)
    lbl.TextColor3 = Color3.fromRGB(0, 255, 65)
    lbl.TextSize = 11
    lbl.Font = Enum.Font.Code
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextTruncate = Enum.TextTruncate.AtEnd
    lbl.ZIndex = 2
    lbl.Parent = btn

    if isUniversal then
        lbl.Text = "Universal Scripts"
        icon.Image = "rbxassetid://6023426915"
    else
        local numId = tonumber(gameData.GameId)
        if numId then
            -- Show a fast local fallback first so something always renders.
            icon.Image = "rbxthumb://type=GameIcon&id=" .. tostring(numId) .. "&w=150&h=150"
            -- Resolve the asset id in the background and swap in.
            task.spawn(function()
                local asset = resolveIconAsset(numId)
                if asset then
                    icon.Image = "rbxthumb://type=Asset&id=" .. tostring(asset) .. "&w=150&h=150"
                end
                local ok, info = pcall(function()
                    return MarketplaceService:GetProductInfo(numId, Enum.InfoType.Game)
                end)
                if ok and info and info.Name then lbl.Text = info.Name end
            end)
        end
    end

    btn.MouseButton1Click:Connect(function() onClick(gameData) end)
    return btn
end

