local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

local LocalPlayer = Players.LocalPlayer

-- Create a ScreenGui to hold the names
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SimpleTeamESP"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = game:GetService("CoreGui")

-- Store drawings/UI for each player
local ESPObjects = {}

-- Function to update/create ESP for a player
local function createESP(player)
    if player == LocalPlayer then return end
    
    -- Create a BillboardGui attached to the player's Head
    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "TeamESP"
    Billboard.AlwaysOnTop = true
    Billboard.Size = UDim2.new(0, 200, 0, 50)
    Billboard.StudsOffset = Vector3.new(0, 2.5, 0) -- Position above head
    Billboard.Adornee = nil -- Set later
    Billboard.Parent = ScreenGui
    
    -- The Name Text
    local NameLabel = Instance.new("TextLabel")
    NameLabel.Name = "NameLabel"
    NameLabel.BackgroundTransparency = 1
    NameLabel.Size = UDim2.new(1, 0, 1, 0)
    NameLabel.Font = Enum.Font.GothamBold
    NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    NameLabel.TextStrokeTransparency = 0
    NameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    NameLabel.TextSize = 14
    NameLabel.Text = player.Name
    NameLabel.Parent = Billboard
    
    ESPObjects[player] = {
        Billboard = Billboard,
        NameLabel = NameLabel
    }
end

-- Update loop
RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        local character = player.Character
        if not character then
            if ESPObjects[player] then
                ESPObjects[player].Billboard.Enabled = false
            end
            continue
        end
        
        local head = character:FindFirstChild("Head")
        if not head then continue end
        
        -- If ESP doesn't exist, create it
        if not ESPObjects[player] then
            createESP(player)
        end
        
        local esp = ESPObjects[player]
        esp.Billboard.Adornee = head
        esp.Billboard.Enabled = true
        
        -- Set name text
        esp.NameLabel.Text = player.Name
        
        -- Set the name color to their team color, or white if no team
        if player.Team then
            esp.NameLabel.TextColor3 = player.TeamColor.Color
        else
            esp.NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
        
        -- Distance scaling (further away = smaller text)
        local distance = (Camera.CFrame.Position - head.Position).Magnitude
        local scale = math.clamp(1 - (distance / 200), 0.3, 1) -- Adjust 200 to change max distance
        esp.NameLabel.TextSize = 14 * scale
        
        -- Highlight the body in team color
        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                if player.Team then
                    part.Color = player.TeamColor.Color
                else
                    part.Color = Color3.fromRGB(255, 0, 0) -- Default red if no team
                end
            end
        end
    end
end)

-- Cleanup when players leave
Players.PlayerRemoving:Connect(function(player)
    if ESPObjects[player] then
        ESPObjects[player].Billboard:Destroy()
        ESPObjects[player] = nil
    end
end)
